#cloud-config
# The only value embedded from Terraform is the PUBLIC SSH key. No PIA or API credentials.
hostname: lodestar-${role_label}
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - wireguard-tools
  - unattended-upgrades
users:
  - name: lodestar
    gecos: Lodestar Test Administrator
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
write_files:
  - path: /etc/sudoers.d/99-lodestar-automation
    owner: root:root
    permissions: '0440'
    content: |
      # Restricted, auditable non-interactive sudoers permission: ONLY the root-owned deployment helper
      lodestar ALL=(root) NOPASSWD: /usr/local/sbin/lodestar-vpn-helper
  - path: /usr/local/sbin/lodestar-vpn-helper
    owner: root:root
    permissions: '0750'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      umask 027

      CONFIG_DIR="/run/lodestar/vpn"
      CONFIG_FILE="/run/lodestar/vpn/wg0.conf"
      COMPOSE_DIR="/home/lodestar/lodestar/pia-example"
      COMPOSE_FILE="/home/lodestar/lodestar/pia-example/compose.vpn.yaml"

      cmd="$${1:-}"
      case "$cmd" in
        preflight)
          docker info >/dev/null 2>&1
          test -c /dev/net/tun
          echo "PREFLIGHT_OK"
          ;;
        write-config)
          # Prevent symlink attacks on parent directory and target file
          if [ -L "$CONFIG_DIR" ]; then
            echo "ERROR: $CONFIG_DIR is a symlink" >&2
            exit 1
          fi
          install -d -m 0700 -o root -g root "$CONFIG_DIR"
          tmp_cfg="$CONFIG_DIR/wg0.tmp.$$"
          cat > "$tmp_cfg"
          chmod 0600 "$tmp_cfg"
          chown root:root "$tmp_cfg"
          if ! grep -q '^\[Interface\]' "$tmp_cfg" || ! grep -q '^\[Peer\]' "$tmp_cfg"; then
            rm -f "$tmp_cfg"
            echo "ERROR: Invalid WireGuard configuration payload" >&2
            exit 1
          fi
          if [ -L "$CONFIG_FILE" ]; then
            rm -f "$CONFIG_FILE"
          fi
          mv -f "$tmp_cfg" "$CONFIG_FILE"
          chmod 0600 "$CONFIG_FILE"
          chown root:root "$CONFIG_FILE"
          echo "CONFIG_OK"
          ;;
        verify-permissions)
          if [ -L "$CONFIG_DIR" ] || [ ! -d "$CONFIG_DIR" ]; then
            echo "ERROR: $CONFIG_DIR missing or symlink" >&2
            exit 1
          fi
          if [ -L "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ]; then
            echo "ERROR: $CONFIG_FILE missing or symlink" >&2
            exit 1
          fi
          stat -c '%a %U:%G' "$CONFIG_DIR"
          stat -c '%a %U:%G' "$CONFIG_FILE"
          ;;
        install-compose)
          if [ -L "$COMPOSE_DIR" ]; then
            echo "ERROR: $COMPOSE_DIR is a symlink" >&2
            exit 1
          fi
          install -d -m 0755 -o root -g root "$COMPOSE_DIR"
          tmp_compose="$COMPOSE_DIR/compose.tmp.$$"
          cat > "$tmp_compose"
          if grep -q -E '/var/run/docker\.sock|privileged:\s*true|network_mode:\s*["'\''?]host["'\''?]' "$tmp_compose"; then
            rm -f "$tmp_compose"
            echo "ERROR: Insecure compose directive rejected (docker.sock/privileged/host-net)" >&2
            exit 1
          fi
          if [ -L "$COMPOSE_FILE" ]; then
            rm -f "$COMPOSE_FILE"
          fi
          mv -f "$tmp_compose" "$COMPOSE_FILE"
          chmod 0644 "$COMPOSE_FILE"
          chown root:root "$COMPOSE_FILE"
          docker compose -f "$COMPOSE_FILE" config --quiet
          echo "COMPOSE_OK"
          ;;
        validate-compose)
          if [ ! -f "$COMPOSE_FILE" ] || [ -L "$COMPOSE_FILE" ]; then
            echo "ERROR: $COMPOSE_FILE missing or symlink" >&2
            exit 1
          fi
          docker compose -f "$COMPOSE_FILE" config --quiet
          echo "COMPOSE_VALID"
          ;;
        start-vpn)
          if [ ! -f "$COMPOSE_FILE" ] || [ -L "$COMPOSE_FILE" ]; then
            echo "ERROR: $COMPOSE_FILE missing or symlink" >&2
            exit 1
          fi
          if [ ! -f "$CONFIG_FILE" ] || [ -L "$CONFIG_FILE" ]; then
            echo "ERROR: $CONFIG_FILE missing or symlink" >&2
            exit 1
          fi
          docker compose -f "$COMPOSE_FILE" up -d gluetun
          echo "VPN_STARTED"
          ;;
        start-crawler)
          if [ ! -f "$COMPOSE_FILE" ] || [ -L "$COMPOSE_FILE" ]; then
            echo "ERROR: $COMPOSE_FILE missing or symlink" >&2
            exit 1
          fi
          docker compose -f "$COMPOSE_FILE" up -d crawler
          echo "CRAWLER_STARTED"
          ;;
        stop-vpn)
          if [ -f "$COMPOSE_FILE" ]; then
            docker compose -f "$COMPOSE_FILE" down
          fi
          echo "STOP_OK"
          ;;
        cleanup)
          if [ -f "$COMPOSE_FILE" ]; then
            docker compose -f "$COMPOSE_FILE" down || true
          fi
          if [ -d "$CONFIG_DIR" ] && [ ! -L "$CONFIG_DIR" ]; then
            rm -rf "$CONFIG_DIR"
          fi
          echo "CLEANUP_OK"
          ;;
        wg-handshake)
          docker exec gluetun wg show wg0 latest-handshakes
          ;;
        wg-transfer)
          docker exec gluetun wg show wg0 transfer
          ;;
        wg-endpoints)
          docker exec gluetun wg show wg0 endpoints
          ;;
        query-egress)
          docker exec gluetun curl -s --max-time 5 https://checkip.amazonaws.com
          ;;
        query-ipinfo)
          docker exec gluetun curl -s --max-time 5 https://ipinfo.io/json
          ;;
        query-dns)
          docker exec gluetun nslookup -timeout=5 google.com 127.0.0.1
          ;;
        query-dns-direct)
          docker exec gluetun nslookup -timeout=3 google.com 8.8.8.8
          ;;
        inspect-firewall)
          docker exec gluetun iptables -S OUTPUT
          ;;
        inspect-ipv6)
          docker exec gluetun cat /proc/sys/net/ipv6/conf/all/disable_ipv6
          ;;
        *)
          echo "ERROR: Unauthorized helper command: $cmd" >&2
          exit 1
          ;;
      esac
  - path: /etc/ssh/sshd_config.d/99-lodestar.conf
    owner: root:root
    permissions: '0644'
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
  - path: /usr/local/sbin/lodestar-bootstrap.sh
    owner: root:root
    permissions: '0700'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      umask 027
      install -d -m 0750 /var/log/lodestar
      exec > >(tee -a /var/log/lodestar/bootstrap.log) 2>&1
      trap 'rc=$?; printf "bootstrap failure: exit=%s line=%s UTC=%s\\n" "$rc" "$LINENO" "$(date -u +%FT%TZ)" >&2' ERR
      echo "Bootstrapping Lodestar test VM, UTC=$(date -u +%FT%TZ)"
      . /etc/os-release
      if [[ "$ID" != "ubuntu" || "$VERSION_ID" != "24.04" ]]; then
        echo "ERROR: unsupported distro; expected Ubuntu 24.04" >&2
        exit 1
      fi
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y
      apt-get install -y ca-certificates curl gnupg
      install -m 0755 -d /etc/apt/keyrings
      curl --fail --silent --show-error --location --retry 5 --retry-delay 2 \
        https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
      CODENAME="$(. /etc/os-release && echo "$VERSION_CODENAME")"
      ARCH="$(dpkg --print-architecture)"
      cat > /etc/apt/sources.list.d/docker.sources <<DOCKEREOF
      Types: deb
      URIs: https://download.docker.com/linux/ubuntu
      Suites: $CODENAME
      Components: stable
      Architectures: $ARCH
      Signed-By: /etc/apt/keyrings/docker.asc
      DOCKEREOF
      apt-get update -y
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      systemctl enable --now docker
      systemctl restart ssh
      install -d -o lodestar -g lodestar -m 0700 /home/lodestar/lodestar
      install -d -o lodestar -g lodestar -m 0700 /home/lodestar/lodestar/secrets
      install -d -o lodestar -g lodestar -m 0700 /home/lodestar/lodestar/pia-example
      # Ephemeral runtime directory for WireGuard credentials (tmpfs, root-only)
      install -d -o root -g root -m 0700 /run/lodestar/vpn
      # Never start a crawler on an unverified tunnel.
      docker --version
      docker compose version
      test -c /dev/net/tun || { echo "ERROR: /dev/net/tun unavailable" >&2; exit 1; }
      echo "Bootstrap complete UTC=$(date -u +%FT%TZ)"
runcmd:
  - [bash, /usr/local/sbin/lodestar-bootstrap.sh]
final_message: "Lodestar bootstrap finished; inspect /var/log/lodestar/bootstrap.log and /var/log/cloud-init-output.log."
