#cloud-config
# Embedded from Terraform: the PUBLIC SSH keys and, when the control plane pins it,
# the VM's own SSH host key (OP-2). No PIA or API credentials.
hostname: lodestar-${role_label}
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - wireguard-tools
  - unattended-upgrades
users:
  - name: lodestar
    gecos: Lodestar Test Administrator
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
%{ for k in ssh_public_keys ~}
      - ${k}
%{ endfor ~}
%{ if host_key_private != "" ~}
# The host key the control plane generated, so its fingerprint is pinned before
# first contact. Other host key types are removed and not regenerated.
ssh_deletekeys: true
ssh_genkeytypes: []
ssh_keys:
  ed25519_private: |
    ${indent(4, trimspace(host_key_private))}
  ed25519_public: ${trimspace(host_key_public)}
%{ endif ~}
write_files:
  - path: /etc/sudoers.d/99-lodestar-automation
    owner: root:root
    permissions: '0440'
    content: |
      # Restricted, auditable non-interactive sudoers permission: ONLY the root-owned deployment helper
      lodestar ALL=(root) NOPASSWD: /usr/local/sbin/lodestar-vpn-helper
  - path: /etc/lodestar/vpn/compose.yaml
    owner: root:root
    permissions: '0644'
    content: |
      ${indent(6, compose_vpn_content)}
  - path: /usr/local/sbin/lodestar-vpn-helper
    owner: root:root
    permissions: '0750'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      umask 027

      CONFIG_DIR="/run/lodestar/vpn"
      CONFIG_FILE="/run/lodestar/vpn/wg0.conf"
      COMPOSE_DIR="/etc/lodestar/vpn"
      COMPOSE_FILE="/etc/lodestar/vpn/compose.yaml"

      cmd="$${1:-}"
      case "$cmd" in
        preflight)
          docker info >/dev/null 2>&1
          test -c /dev/net/tun
          echo "PREFLIGHT_OK"
          ;;
        write-config)
          # Prevent symlink attacks on parent directory and target file
          parent_dir="$(dirname "$CONFIG_DIR")"
          if [ -L "$parent_dir" ] || [ -L "$CONFIG_DIR" ]; then
            echo "ERROR: $CONFIG_DIR or parent is a symlink" >&2
            exit 1
          fi
          install -d -m 0755 -o root -g root "$parent_dir"
          install -d -m 0700 -o root -g root "$CONFIG_DIR"
          tmp_cfg="$CONFIG_DIR/wg0.tmp.$$"
          cat > "$tmp_cfg"
          chmod 0600 "$tmp_cfg"
          chown root:root "$tmp_cfg"
          # Reject control characters, shell metacharacters, or dangerous WireGuard directives
          if LC_ALL=C grep -q -E '[`$\\"'\'';|&<>()]' "$tmp_cfg" || \
             grep -q -E -i '^\s*(PostUp|PreUp|PostDown|PreDown|Table|SaveConfig|FwMark|MTU)\s*=' "$tmp_cfg"; then
            rm -f "$tmp_cfg"
            echo "ERROR: Forbidden characters or WireGuard directives in configuration payload" >&2
            exit 1
          fi
          # Enforce strict typed schema for wg0.conf
          if ! awk '
            BEGIN { sec=""; iface=0; peer=0; addr=0; priv=0; dns=0; pub=0; ep=0; aips=0; ka=0; ok=1 }
            /^[[:space:]]*$/ || /^[[:space:]]*#/ { next }
            /^[[:space:]]*\[Interface\][[:space:]]*$/ {
              if (sec != "") { ok=0; exit 1 }
              sec="I"; iface=1; next
            }
            /^[[:space:]]*\[Peer\][[:space:]]*$/ {
              if (sec != "I") { ok=0; exit 1 }
              sec="P"; peer=1; next
            }
            {
              pos = index($0, "=")
              if (pos == 0) { ok=0; exit 1 }
              k = substr($0, 1, pos - 1)
              v = substr($0, pos + 1)
              gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)
              gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
              if (sec == "I") {
                if (k == "Address" && v ~ /^10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\/32$/) { addr++ }
                else if (k == "PrivateKey" && length(v) == 44 && v ~ /^[A-Za-z0-9+\/]{43}=$/) { priv++ }
                else if (k == "DNS" && v ~ /^10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$/) { dns++ }
                else { ok=0; exit 1 }
              } else if (sec == "P") {
                if (k == "PublicKey" && length(v) == 44 && v ~ /^[A-Za-z0-9+\/]{43}=$/) { pub++ }
                else if (k == "Endpoint" && v ~ /^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$/) {
                  split(v, ep_parts, ":")
                  ip = ep_parts[1]
                  port = ep_parts[2] + 0
                  split(ip, o, ".")
                  o1 = o[1] + 0; o2 = o[2] + 0; o3 = o[3] + 0; o4 = o[4] + 0
                  if (o1 <= 0 || o1 > 223 || o2 > 255 || o3 > 255 || o4 > 255) { ok=0; exit 1 }
                  if (o1 == 10 || o1 == 127 || (o1 == 169 && o2 == 254) || (o1 == 192 && o2 == 168) || (o1 == 172 && o2 >= 16 && o2 <= 31) || (o1 == 100 && o2 >= 64 && o2 <= 127)) { ok=0; exit 1 }
                  if (port < 1 || port > 65535) { ok=0; exit 1 }
                  ep++
                }
                else if (k == "AllowedIPs" && v == "0.0.0.0/0") { aips++ }
                else if (k == "PersistentKeepalive" && v == "25") { ka++ }
                else { ok=0; exit 1 }
              } else {
                ok=0; exit 1
              }
            }
            END {
              if (!ok || iface != 1 || peer != 1 || addr != 1 || priv != 1 || dns != 1 || pub != 1 || ep != 1 || aips != 1 || ka != 1) {
                exit 1
              }
            }
          ' "$tmp_cfg"; then
            rm -f "$tmp_cfg"
            echo "ERROR: Invalid WireGuard configuration payload" >&2
            exit 1
          fi
          if [ -L "$CONFIG_FILE" ]; then
            rm -f "$CONFIG_FILE"
          fi
          mv -f "$tmp_cfg" "$CONFIG_FILE"
          chmod 0600 "$CONFIG_FILE"
          chown root:root "$CONFIG_FILE"
          echo "CONFIG_OK"
          ;;
        verify-permissions)
          if [ -L "$CONFIG_DIR" ] || [ ! -d "$CONFIG_DIR" ]; then
            echo "ERROR: $CONFIG_DIR missing or symlink" >&2
            exit 1
          fi
          if [ -L "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ]; then
            echo "ERROR: $CONFIG_FILE missing or symlink" >&2
            exit 1
          fi
          stat -c '%a %U:%G' "$CONFIG_DIR"
          stat -c '%a %U:%G' "$CONFIG_FILE"
          ;;
        validate-compose)
          if [ ! -f "$COMPOSE_FILE" ] || [ -L "$COMPOSE_FILE" ]; then
            echo "ERROR: $COMPOSE_FILE missing or symlink" >&2
            exit 1
          fi
          docker compose -f "$COMPOSE_FILE" config --quiet
          echo "COMPOSE_VALID"
          ;;
        start-vpn)
          if [ ! -f "$COMPOSE_FILE" ] || [ -L "$COMPOSE_FILE" ]; then
            echo "ERROR: $COMPOSE_FILE missing or symlink" >&2
            exit 1
          fi
          if [ ! -f "$CONFIG_FILE" ] || [ -L "$CONFIG_FILE" ]; then
            echo "ERROR: $CONFIG_FILE missing or symlink" >&2
            exit 1
          fi
          docker compose -f "$COMPOSE_FILE" up -d gluetun
          echo "VPN_STARTED"
          ;;
        start-crawler)
          if [ ! -f "$COMPOSE_FILE" ] || [ -L "$COMPOSE_FILE" ]; then
            echo "ERROR: $COMPOSE_FILE missing or symlink" >&2
            exit 1
          fi
          # Trusted Component Authorization Gate:
          # 1. Gluetun container health status must be strictly 'healthy'
          health_status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' gluetun 2>/dev/null || echo "inspect_failed")"
          if [ "$health_status" != "healthy" ]; then
            echo "ERROR: Gluetun health check failed (status: $health_status, required: healthy)" >&2
            exit 1
          fi
          # 2. Verify container service label
          svc_label="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' gluetun 2>/dev/null || true)"
          if [ "$svc_label" != "gluetun" ]; then
            echo "ERROR: Container 'gluetun' missing expected compose service label (got: $svc_label)" >&2
            exit 1
          fi
          # 3. Verify pinned container image digest
          img_id="$(docker inspect -f '{{.Config.Image}}' gluetun 2>/dev/null || true)"
          case "$img_id" in
            *sha256:2b42bfa046757145a5155acece417b65b4443c8033fb88661a8e9dcf7fda5a00*)
              ;;
            *)
              echo "ERROR: Container 'gluetun' is not running approved pinned image digest" >&2
              exit 1
              ;;
          esac
          # 4. WireGuard handshake active and fresh (<= 120s)
          hs_out="$(bash "$0" wg-handshake 2>/dev/null || true)"
          hs_epoch="$(echo "$hs_out" | awk '{print $2}')"
          if [ -z "$hs_epoch" ] || [ "$hs_epoch" -le 0 ] 2>/dev/null; then
            echo "ERROR: WireGuard tunnel handshake missing or inactive" >&2
            exit 1
          fi
          now="$(date +%s)"
          hs_age=$(( now - hs_epoch ))
          if [ "$hs_age" -lt 0 ] || [ "$hs_age" -gt 120 ]; then
            echo "ERROR: WireGuard handshake is stale ($${hs_age}s > 120s limit)" >&2
            exit 1
          fi
          # 5. WireGuard transfer active (rx > 0 and tx > 0)
          tx_out="$(bash "$0" wg-transfer 2>/dev/null || true)"
          rx_b="$(echo "$tx_out" | awk '{print $2}')"
          tx_b="$(echo "$tx_out" | awk '{print $3}')"
          if [ -z "$rx_b" ] || [ -z "$tx_b" ] || [ "$rx_b" -le 0 ] || [ "$tx_b" -le 0 ] 2>/dev/null; then
            echo "ERROR: WireGuard transfer inactive (rx=$${rx_b:-0}, tx=$${tx_b:-0})" >&2
            exit 1
          fi
          # 6. Gluetun killswitch firewall active (-P OUTPUT DROP)
          if ! docker exec gluetun iptables -S OUTPUT 2>/dev/null | grep -q -- '-P OUTPUT DROP'; then
            echo "ERROR: Gluetun firewall killswitch inactive (no -P OUTPUT DROP)" >&2
            exit 1
          fi
          # 7. IPv6 disabled inside container
          if [ "$(docker exec gluetun cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || true)" != "1" ]; then
            echo "ERROR: IPv6 is not disabled inside Gluetun container" >&2
            exit 1
          fi
          # 8. Crawler strictly confined to Gluetun network namespace
          if ! grep -q -E 'network_mode:\s*["'\''?]?(service:gluetun|container:gluetun)["'\''?]?' "$COMPOSE_FILE"; then
            echo "ERROR: Crawler is not restricted to Gluetun network namespace in $COMPOSE_FILE" >&2
            exit 1
          fi
          docker compose -f "$COMPOSE_FILE" --profile crawler up -d crawler
          echo "CRAWLER_STARTED"
          ;;
        stop-vpn)
          if [ -f "$COMPOSE_FILE" ]; then
            docker compose -f "$COMPOSE_FILE" --profile crawler down 2>/dev/null || docker compose -f "$COMPOSE_FILE" down
          fi
          echo "STOP_OK"
          ;;
        cleanup)
          if [ -f "$COMPOSE_FILE" ]; then
            docker compose -f "$COMPOSE_FILE" --profile crawler down 2>/dev/null || docker compose -f "$COMPOSE_FILE" down || true
          fi
          if [ -d "$CONFIG_DIR" ] && [ ! -L "$CONFIG_DIR" ]; then
            rm -rf "$CONFIG_DIR"
          fi
          echo "CLEANUP_OK"
          ;;
        wg-handshake)
          # Query WireGuard handshake via host nsenter (wireguard-tools on Ubuntu 24.04 host)
          # or fall back to container wg / sysfs carrier + Gluetun healthcheck
          gluetun_pid="$(docker inspect -f '{{.State.Pid}}' gluetun 2>/dev/null || true)"
          hs_out=""
          if [ -n "$gluetun_pid" ] && [ "$gluetun_pid" -gt 0 ] 2>/dev/null && command -v nsenter >/dev/null 2>&1 && command -v wg >/dev/null 2>&1; then
            hs_out="$(nsenter -t "$gluetun_pid" -n wg show wg0 latest-handshakes 2>/dev/null || true)"
          fi
          if [ -z "$hs_out" ]; then
            hs_out="$(docker exec gluetun wg show wg0 latest-handshakes 2>/dev/null || true)"
          fi
          if [ -z "$hs_out" ]; then
            carrier="$(docker exec gluetun cat /sys/class/net/wg0/carrier 2>/dev/null || true)"
            rx_b="$(docker exec gluetun cat /sys/class/net/wg0/statistics/rx_bytes 2>/dev/null || true)"
            if [ "$carrier" = "1" ] && [ -n "$rx_b" ] && [ "$rx_b" -gt 0 ] 2>/dev/null; then
              peer_pub="$(awk -F'=' '/^[[:space:]]*PublicKey[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$CONFIG_FILE" 2>/dev/null || echo "wg0_peer")"
              hs_out="$${peer_pub:-wg0_peer} $(date +%s)"
            fi
          fi
          if [ -z "$hs_out" ]; then
            exit 1
          fi
          echo "$hs_out"
          ;;
        wg-transfer)
          gluetun_pid="$(docker inspect -f '{{.State.Pid}}' gluetun 2>/dev/null || true)"
          tx_out=""
          if [ -n "$gluetun_pid" ] && [ "$gluetun_pid" -gt 0 ] 2>/dev/null && command -v nsenter >/dev/null 2>&1 && command -v wg >/dev/null 2>&1; then
            tx_out="$(nsenter -t "$gluetun_pid" -n wg show wg0 transfer 2>/dev/null || true)"
          fi
          if [ -z "$tx_out" ]; then
            tx_out="$(docker exec gluetun wg show wg0 transfer 2>/dev/null || true)"
          fi
          if [ -z "$tx_out" ]; then
            rx_b="$(docker exec gluetun cat /sys/class/net/wg0/statistics/rx_bytes 2>/dev/null || true)"
            tx_b="$(docker exec gluetun cat /sys/class/net/wg0/statistics/tx_bytes 2>/dev/null || true)"
            if [ -n "$rx_b" ] && [ -n "$tx_b" ]; then
              peer_pub="$(awk -F'=' '/^[[:space:]]*PublicKey[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$CONFIG_FILE" 2>/dev/null || echo "wg0_peer")"
              tx_out="$${peer_pub:-wg0_peer} $rx_b $tx_b"
            fi
          fi
          if [ -z "$tx_out" ]; then
            exit 1
          fi
          echo "$tx_out"
          ;;
        wg-endpoints)
          gluetun_pid="$(docker inspect -f '{{.State.Pid}}' gluetun 2>/dev/null || true)"
          ep_out=""
          if [ -n "$gluetun_pid" ] && [ "$gluetun_pid" -gt 0 ] 2>/dev/null && command -v nsenter >/dev/null 2>&1 && command -v wg >/dev/null 2>&1; then
            ep_out="$(nsenter -t "$gluetun_pid" -n wg show wg0 endpoints 2>/dev/null || true)"
          fi
          if [ -z "$ep_out" ]; then
            ep_out="$(docker exec gluetun wg show wg0 endpoints 2>/dev/null || true)"
          fi
          if [ -z "$ep_out" ] && [ -f "$CONFIG_FILE" ]; then
            peer_pub="$(awk -F'=' '/^[[:space:]]*PublicKey[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$CONFIG_FILE" 2>/dev/null || echo "wg0_peer")"
            cfg_ep="$(awk -F'=' '/^[[:space:]]*Endpoint[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$CONFIG_FILE" 2>/dev/null || true)"
            if [ -n "$cfg_ep" ]; then
              ep_out="$${peer_pub:-wg0_peer} $cfg_ep"
            fi
          fi
          if [ -z "$ep_out" ]; then
            exit 1
          fi
          echo "$ep_out"
          ;;
        query-egress)
          # Use wget (installed in Gluetun v3.40.0 Alpine image) or Gluetun's /tmp/gluetun/ip
          egress_ip="$(docker exec gluetun wget -qO- -T 5 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]' || true)"
          if [ -z "$egress_ip" ]; then
            egress_ip="$(docker exec gluetun cat /tmp/gluetun/ip 2>/dev/null | tr -d '[:space:]' || true)"
          fi
          if [ -z "$egress_ip" ]; then
            exit 1
          fi
          echo "$egress_ip"
          ;;
        query-ipinfo)
          # Use wget (installed in Gluetun v3.40.0 Alpine image)
          docker exec gluetun wget -qO- -T 5 https://ipinfo.io/json
          ;;
        query-dns)
          # Query Gluetun built-in DoT DNS server on 127.0.0.1:53
          docker exec gluetun nslookup -timeout=5 google.com 127.0.0.1
          ;;
        query-dns-vpn)
          # Query public DNS via default VPN tunnel route (wg0)
          docker exec gluetun nslookup -timeout=5 google.com 8.8.8.8
          ;;
        verify-dns-route)
          # Validate that DNS traffic routes through wg0 and NOT eth0
          route_out="$(docker exec gluetun ip route get 8.8.8.8 2>/dev/null || true)"
          if echo "$route_out" | grep -q 'dev wg0'; then
            echo "DNS_ROUTE_WG0_OK"
          else
            echo "ERROR: DNS route does not go through wg0: $route_out" >&2
            exit 1
          fi
          ;;
        verify-dns-firewall)
          # Dynamically discover non-VPN interface (e.g. eth0, ens3, etc.)
          non_vpn_if="$(docker exec gluetun ip -o link show 2>/dev/null | awk -F': ' '{sub(/@.*/, "", $2); if ($2 !~ /^(lo|wg0)$/) print $2}' | head -n1)"
          if [ -z "$non_vpn_if" ]; then
            echo "ERROR: Failed to discover non-VPN interface in Gluetun container" >&2
            exit 1
          fi

          # Inspect iptables OUTPUT chain in gluetun
          fw_rules="$(docker exec gluetun iptables -S OUTPUT 2>/dev/null || true)"
          if [ -z "$fw_rules" ]; then
            echo "ERROR: Failed to inspect Gluetun iptables OUTPUT rules" >&2
            exit 1
          fi

          # 1. Assert default policy is -P OUTPUT DROP
          if ! echo "$fw_rules" | grep -q -- '-P OUTPUT DROP'; then
            echo "ERROR: Default OUTPUT policy is not DROP" >&2
            exit 1
          fi

          # 2. Assert loopback (-o lo) is accepted
          if ! echo "$fw_rules" | grep -q -- '-A OUTPUT -o lo -j ACCEPT'; then
            echo "ERROR: Loopback egress rule (-o lo -j ACCEPT) missing" >&2
            exit 1
          fi

          # 3. Assert WireGuard (-o wg0) is accepted
          if ! echo "$fw_rules" | grep -q -- '-A OUTPUT -o wg0 -j ACCEPT'; then
            echo "ERROR: WireGuard egress rule (-o wg0 -j ACCEPT) missing" >&2
            exit 1
          fi

          # 4. Discover and strictly validate legitimate VPN endpoint server IP
          raw_ep="$(bash "$0" wg-endpoints 2>/dev/null | awk '{print $2}' | cut -d: -f1 || true)"
          if [ -z "$raw_ep" ] && [ -f "$CONFIG_FILE" ]; then
            raw_ep="$(awk -F'=' '/^[[:space:]]*Endpoint[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); split($2, a, ":"); print a[1]; exit}' "$CONFIG_FILE" 2>/dev/null || true)"
          fi
          vpn_server_ip=""
          if echo "$raw_ep" | grep -q -E '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
            vpn_server_ip="$raw_ep"
          fi

          # 5. Strict evaluation of every OUTPUT rule using awk (no regex interpolation of config values):
          # Fail closed if ANY rule permits unauthorized egress, custom chain jumps, or unconstrained ACCEPT
          if ! echo "$fw_rules" | awk -v vpn_ip="$vpn_server_ip" '
            function is_rfc1918_cidr(cidr,   parts, ip, mask, o, o1, o2, o3, o4) {
              if (cidr !~ /^[0-9]{1,3}(\.[0-9]{1,3}){3}\/[0-9]{1,2}$/) return 0
              split(cidr, parts, "/")
              ip = parts[1]; mask = parts[2] + 0
              if (mask < 8 || mask > 32) return 0
              split(ip, o, ".")
              o1 = o[1] + 0; o2 = o[2] + 0; o3 = o[3] + 0; o4 = o[4] + 0
              if (o1 > 255 || o2 > 255 || o3 > 255 || o4 > 255) return 0
              if (o1 == 10 && mask >= 8) return 1
              if (o1 == 172 && o2 >= 16 && o2 <= 31 && mask >= 12) return 1
              if (o1 == 192 && o2 == 168 && mask >= 16) return 1
              return 0
            }
            {
              gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
              if ($0 == "" || $0 == "-P OUTPUT DROP") next
              if ($0 ~ /-j (DROP|REJECT)([[:space:]]|$)/) next
              if ($0 ~ /-j ACCEPT([[:space:]]|$)/) {
                # a) Loopback interface
                if ($0 == "-A OUTPUT -o lo -j ACCEPT") next
                # b) WireGuard VPN tunnel interface
                if ($0 == "-A OUTPUT -o wg0 -j ACCEPT") next
                # c) Stateful established / related connection tracking
                if ($0 ~ /^-A OUTPUT -m (conntrack --ctstate|state --state) (RELATED,ESTABLISHED|ESTABLISHED,RELATED) -j ACCEPT$/) next
                # d) Legitimate VPN server peer IP UDP connection (exact IP comparison, never regex)
                if (vpn_ip != "" && ($0 ~ /-p udp/) && (index($0, "-d " vpn_ip "/32 ") > 0 || index($0, "-d " vpn_ip " ") > 0)) next
                # e) Gluetun local Docker bridge subnet rule: -A OUTPUT -s <rfc1918>/32 -d <rfc1918>/<mask> -o <if> -j ACCEPT
                if ($0 ~ /^-A OUTPUT -s [0-9.]+\/32 -d [0-9.]+\/[0-9]+ -o [a-zA-Z0-9_.-]+ -j ACCEPT$/) {
                  src = ""; dst = ""
                  for (i = 1; i <= NF; i++) {
                    if ($i == "-s") src = $(i+1)
                    if ($i == "-d") dst = $(i+1)
                  }
                  if (is_rfc1918_cidr(src) && is_rfc1918_cidr(dst)) next
                }
                print "ERROR: Unauthorized egress rule in Gluetun firewall: " $0 > "/dev/stderr"
                exit 1
              }
              print "ERROR: Unexpected or insecure firewall directive in OUTPUT chain: " $0 > "/dev/stderr"
              exit 1
            }
          '; then
            exit 1
          fi

          # 6. IPv6 check: Must be disabled inside Gluetun container
          if [ "$(docker exec gluetun cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || true)" != "1" ]; then
            echo "ERROR: IPv6 is not disabled inside Gluetun container" >&2
            exit 1
          fi

          # 7. Assert ip route get 8.8.8.8 routes via dev wg0
          route_out="$(docker exec gluetun ip route get 8.8.8.8 2>/dev/null || true)"
          if ! echo "$route_out" | grep -q 'dev wg0'; then
            echo "ERROR: DNS route does not go through wg0: $route_out" >&2
            exit 1
          fi

          echo "DNS_FIREWALL_OK"
          ;;
        inspect-firewall)
          docker exec gluetun iptables -S OUTPUT
          ;;
        inspect-ipv6)
          docker exec gluetun cat /proc/sys/net/ipv6/conf/all/disable_ipv6
          ;;
        *)
          echo "ERROR: Unauthorized helper command: $cmd" >&2
          exit 1
          ;;
      esac
  - path: /etc/ssh/sshd_config.d/99-lodestar.conf
    owner: root:root
    permissions: '0644'
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
  - path: /usr/local/sbin/lodestar-bootstrap.sh
    owner: root:root
    permissions: '0700'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      umask 027
      install -d -m 0750 /var/log/lodestar
      exec > >(tee -a /var/log/lodestar/bootstrap.log) 2>&1
      trap 'rc=$?; printf "bootstrap failure: exit=%s line=%s UTC=%s\\n" "$rc" "$LINENO" "$(date -u +%FT%TZ)" >&2' ERR
      echo "Bootstrapping Lodestar test VM, UTC=$(date -u +%FT%TZ)"
      . /etc/os-release
      if [[ "$ID" != "ubuntu" || "$VERSION_ID" != "24.04" ]]; then
        echo "ERROR: unsupported distro; expected Ubuntu 24.04" >&2
        exit 1
      fi
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y
      apt-get install -y ca-certificates curl gnupg
      install -m 0755 -d /etc/apt/keyrings
      curl --fail --silent --show-error --location --retry 5 --retry-delay 2 \
        https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
      CODENAME="$(. /etc/os-release && echo "$VERSION_CODENAME")"
      ARCH="$(dpkg --print-architecture)"
      cat > /etc/apt/sources.list.d/docker.sources <<DOCKEREOF
      Types: deb
      URIs: https://download.docker.com/linux/ubuntu
      Suites: $CODENAME
      Components: stable
      Architectures: $ARCH
      Signed-By: /etc/apt/keyrings/docker.asc
      DOCKEREOF
      apt-get update -y
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      systemctl enable --now docker
      systemctl restart ssh
      install -d -o lodestar -g lodestar -m 0700 /home/lodestar/lodestar
      # Root-owned immutable Compose stack directory
      install -d -o root -g root -m 0755 /etc/lodestar/vpn
      # Ephemeral runtime directory for WireGuard credentials (tmpfs, root-only)
      install -d -o root -g root -m 0755 /run/lodestar
      install -d -o root -g root -m 0700 /run/lodestar/vpn
      # Never start a crawler on an unverified tunnel.
      docker --version
      docker compose version
      test -c /dev/net/tun || { echo "ERROR: /dev/net/tun unavailable" >&2; exit 1; }
      echo "Bootstrap complete UTC=$(date -u +%FT%TZ)"
runcmd:
  - [bash, /usr/local/sbin/lodestar-bootstrap.sh]
final_message: "Lodestar bootstrap finished; inspect /var/log/lodestar/bootstrap.log and /var/log/cloud-init-output.log."
