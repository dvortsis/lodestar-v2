+	{#if open && Body}<div class="config-body"><Body {form} {specs} /></div>{/if}
+</details>
+
+<style>
+	.config-summary {
+		display: flex;
+		align-items: center;
+		min-height: var(--control-height);
+		cursor: pointer;
+	}
+	@media (pointer: coarse) {
+		.config-summary {
+			min-height: var(--target-min);
+		}
+	}
+	.config-body {
+		margin-top: calc(var(--spacing) * 2);
+	}
