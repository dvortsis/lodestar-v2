+import { describe, expect, it } from 'vitest';
+import { configToml, envLines, envValue, tomlDottedKey, tomlString, tomlValue } from './toml';
+
+describe('tomlString', () => {
+	it.each([
+		['plain', '"plain"'],
+		['say "hi"', '"say \\"hi\\""'],
+		['C:\\data\\lodestar', '"C:\\\\data\\\\lodestar"'],
+		['line one\nline two', '"line one\\nline two"'],
+		['tab\there\r\n', '"tab\\there\\r\\n"'],
+		['\b\f', '"\\b\\f"'],
+		['bell\u0007 and nul\u0000 and del\u007f', '"bell\\u0007 and nul\\u0000 and del\\u007F"'],
+		['Zürich 日本語 🧭', '"Zürich 日本語 🧭"'],
+		['\ud800 alone', '"\\uFFFD alone"'],
+		['alone \udc00', '"alone \\uFFFD"'],
+		['', '""'],
+		['# not a comment', '"# not a comment"'],
+		["it's", '"it\'s"']
+	])('writes %j as %s', (given, written) => {
+		expect(tomlString(given)).toBe(written);
+	});
+
+	it('escapes backslash before quote, so a trailing backslash cannot close the string', () => {
+		expect(tomlString('a\\')).toBe('"a\\\\"');
+		expect(tomlString('\\"')).toBe('"\\\\\\""');
+	});
+});
+
+describe('tomlValue', () => {
+	it('writes every scalar', () => {
+		expect([true, false, 0, 7000, -3, 1.5, -0, 1e21].map(tomlValue)).toEqual([
+			'true',
+			'false',
+			'0',
+			'7000',
+			'-3',
+			'1.5',
+			'-0',
+			'1e+21'
+		]);
+		expect([NaN, Infinity, -Infinity].map(tomlValue)).toEqual(['nan', 'inf', '-inf']);
+		expect(tomlValue(10n)).toBe('10');
+	});
+
+	it('writes lists and maps inline, quoting keys that are not bare', () => {
+		expect(tomlValue(['a', 'b"c', 3])).toBe('["a", "b\\"c", 3]');
+		expect(tomlValue([])).toBe('[]');
+		expect(tomlValue({ dht: 'debug', 'my key': 'x' })).toBe('{ dht = "debug", "my key" = "x" }');
+		expect(tomlValue({})).toBe('{}');
+		expect(tomlValue({ a: { b: [1, { c: true }] } })).toBe('{ a = { b = [1, { c = true }] } }');
+	});
+
+	it('has no form for null, undefined or anything holding one', () => {
+		expect(tomlValue(null)).toBeUndefined();
+		expect(tomlValue(undefined)).toBeUndefined();
+		expect(tomlValue([1, null])).toBeUndefined();
+		expect(tomlValue({ a: null })).toBeUndefined();
+		expect(tomlValue(() => 1)).toBeUndefined();
+	});
+});
+
+describe('keys', () => {
+	it('keeps dots as separators and quotes parts that need it', () => {
+		expect(tomlDottedKey('dht.intensity')).toBe('dht.intensity');
+		expect(tomlDottedKey('http.secure_cookies')).toBe('http.secure_cookies');
+		expect(tomlDottedKey('a b.c')).toBe('"a b".c');
+		expect(tomlDottedKey('é.x')).toBe('"é".x');
+	});
+});
+
+describe('configToml and envLines', () => {
+	const entries = [
+		{ config: 'dht.intensity', env: 'LODESTAR_INTENSITY', value: 'low' },
+		{ config: 'fetch.timeout_secs', value: 30 },
+		{ config: 'log', env: 'LODESTAR_LOG', value: { dht: 'debug' } },
+		{ value: false },
+		{ config: 'dht.bind', env: 'LODESTAR_DHT_PORT', value: null },
+		{ config: 'store.path', env: 'LODESTAR_DATA_DIR', value: 'D:\\Lodestar "data"\nnext' }
+	];
+
+	it('writes one line per value with its variable as a comment, skipping what has no key or form', () => {
+		expect(configToml(entries)).toBe(
+			[
+				'dht.intensity = "low"  # LODESTAR_INTENSITY',
+				'fetch.timeout_secs = 30',
+				'log = { dht = "debug" }  # LODESTAR_LOG',
+				'store.path = "D:\\\\Lodestar \\"data\\"\\nnext"  # LODESTAR_DATA_DIR'
+			].join('\n')
+		);
+	});
+
+	it('writes LODESTAR_ lines for scalars only, quoting what a .env file would split', () => {
+		expect(envLines(entries)).toBe(
+			['LODESTAR_INTENSITY=low', 'LODESTAR_DATA_DIR="D:\\\\Lodestar \\"data\\"\\nnext"'].join('\n')
+		);
+		expect(envValue(true)).toBe('true');
+		expect(envValue(7000)).toBe('7000');
+		expect(envValue('0.0.0.0:8090')).toBe('0.0.0.0:8090');
+		expect(envValue('')).toBe('""');
+		expect(envValue('a b')).toBe('"a b"');
+		expect(envValue('$HOME')).toBe('"\\$HOME"');
+		expect(envValue(['a'])).toBeUndefined();
+		expect(envValue({ a: 1 })).toBeUndefined();
+		expect(envValue(null)).toBeUndefined();
+		expect(envValue(NaN)).toBeUndefined();
+	});
+
+	it('is empty for nothing', () => {
+		expect(configToml([])).toBe('');
+		expect(envLines([])).toBe('');
+	});
+});
diff --git a/web/src/lib/features/settings/screens/toml.ts b/web/src/lib/features/settings/screens/toml.ts
new file mode 100644
index 00000000..84504e97
--- /dev/null
+++ b/web/src/lib/features/settings/screens/toml.ts
@@ -0,0 +1,117 @@
+// View as config.toml (§10.10.2): a screen's values that aren't at their default, as `config.toml`
+// lines (`dht.intensity = "low"  # LODESTAR_INTENSITY`, dotted keys at the top level are valid TOML)
+// and as `LODESTAR_*` lines for a compose file or an Unraid template. Strings use TOML basic-string
+// escaping; lists and maps are inline. Secrets never appear: the caller leaves out `writeOnly`.
+
+const BARE_KEY = /^[A-Za-z0-9_-]+$/;
+
+/** A TOML basic string: `"`, `\` and control characters escaped, everything else as written. */
+export function tomlString(s: string): string {
+	let out = '"';
+	for (let i = 0; i < s.length; i++) {
+		const c = s.charCodeAt(i);
+		const ch = s[i]!;
+		if (ch === '"') out += '\\"';
+		else if (ch === '\\') out += '\\\\';
+		else if (ch === '\n') out += '\\n';
+		else if (ch === '\r') out += '\\r';
+		else if (ch === '\t') out += '\\t';
+		else if (ch === '\b') out += '\\b';
+		else if (ch === '\f') out += '\\f';
+		else if (c < 0x20 || c === 0x7f) out += `\\u${c.toString(16).padStart(4, '0').toUpperCase()}`;
+		else if (c >= 0xd800 && c <= 0xdbff) {
+			// A surrogate pair is one character; a lone surrogate isn't valid TOML.
+			const next = s.charCodeAt(i + 1);
+			if (next >= 0xdc00 && next <= 0xdfff) {
+				out += ch + s[i + 1];
+				i++;
+			} else out += '\\uFFFD';
+		} else if (c >= 0xdc00 && c <= 0xdfff) out += '\\uFFFD';
+		else out += ch;
+	}
+	return `${out}"`;
+}
+
+/** A key part: bare when it can be, else a quoted string. */
+export function tomlKey(k: string): string {
+	return BARE_KEY.test(k) ? k : tomlString(k);
+}
+
+/** A dotted key (`dht.intensity`), each part quoted only when it must be. */
+export function tomlDottedKey(key: string): string {
+	return key.split('.').map(tomlKey).join('.');
+}
+
+/** A value as TOML, or undefined when it has no TOML form (`null`, `undefined`, a function). */
+export function tomlValue(v: unknown): string | undefined {
+	if (typeof v === 'string') return tomlString(v);
+	if (typeof v === 'boolean') return v ? 'true' : 'false';
+	if (typeof v === 'number') {
+		if (Number.isNaN(v)) return 'nan';
+		if (!Number.isFinite(v)) return v > 0 ? 'inf' : '-inf';
+		return Object.is(v, -0) ? '-0' : String(v);
+	}
+	if (typeof v === 'bigint') return v.toString();
+	if (Array.isArray(v)) {
+		const items = v.map(tomlValue);
+		// TOML has no null: an array with one can't be written faithfully, so none of it is.
+		return items.every((i) => i !== undefined) ? `[${items.join(', ')}]` : undefined;
+	}
+	if (typeof v === 'object' && v !== null) {
+		const entries = Object.entries(v).map(([k, x]) => [k, tomlValue(x)] as const);
+		if (entries.some(([, x]) => x === undefined)) return undefined;
+		return entries.length
+			? `{ ${entries.map(([k, x]) => `${tomlKey(k)} = ${x}`).join(', ')} }`
+			: '{}';
+	}
+	return undefined;
+}
+
+/**
+ * A value as an environment variable's text. Scalars only (the server reads a list or a map from
+ * `config.toml`, not from one variable). A value with a space, quote, `#` or `$` is double-quoted
+ * so a compose file or an `.env` file reads it back whole.
+ */
+export function envValue(v: unknown): string | undefined {
+	let text: string;
+	if (typeof v === 'string') text = v;
+	else if (typeof v === 'boolean') text = v ? 'true' : 'false';
+	else if (typeof v === 'number' && Number.isFinite(v)) text = String(v);
+	else return undefined;
+	if (/[\s"'#$\\]|^$/.test(text)) {
+		return `"${text
+			.replace(/[\\"$]/g, '\\$&')
+			.replace(/\n/g, '\\n')
+			.replace(/\r/g, '\\r')}"`;
+	}
+	return text;
+}
+
+export interface ConfigEntry {
+	/** `x-config`, e.g. `dht.intensity`; absent for a setting only the app saves. */
+	config?: string;
+	/** `LODESTAR_*`, e.g. `LODESTAR_INTENSITY`. */
+	env?: string;
+	value: unknown;
+}
+
+/** The `config.toml` lines, in the order given. */
+export function configToml(entries: readonly ConfigEntry[]): string {
+	const lines: string[] = [];
+	for (const e of entries) {
+		const value = e.config ? tomlValue(e.value) : undefined;
+		if (!e.config || value === undefined) continue;
+		lines.push(`${tomlDottedKey(e.config)} = ${value}${e.env ? `  # ${e.env}` : ''}`);
+	}
+	return lines.join('\n');
+}
+
+/** The `LODESTAR_X=value` lines for a compose file or an Unraid template. */
+export function envLines(entries: readonly ConfigEntry[]): string {
+	const lines: string[] = [];
+	for (const e of entries) {
+		const value = e.env ? envValue(e.value) : undefined;
+		if (e.env && value !== undefined) lines.push(`${e.env}=${value}`);
+	}
+	return lines.join('\n');
+}
