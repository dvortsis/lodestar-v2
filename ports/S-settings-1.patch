+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { screens as mine } from '../screens/screen';
+import { ALIASES, buildRegistry, collect, fieldsFor, registered, sortScreens } from './registry';
+import { goldenView, screen } from './testing';
+
+beforeEach(() => vi.spyOn(console, 'error').mockImplementation(() => {}));
+
+describe('discovery', () => {
+	it('finds screen, screens and default exports, each screen once', () => {
+		const a = screen('a');
+		const b = screen('b');
+		const c = screen('c');
+		const d = screen('d');
+		const found = collect({
+			'/one.ts': { screen: a, default: a },
+			'/two.ts': { screens: [b, c] },
+			'/three.ts': { default: [d] },
+			'/four.ts': {}
+		});
+		expect(found.map((s) => s.id).sort()).toEqual(['a', 'b', 'c', 'd']);
+	});
+
+	it('skips what is not a screen, an unknown group and a repeated id, with a dev error', () => {
+		const first = screen('x');
+		const found = collect({
+			'/a.ts': { screen: first },
+			'/b.ts': { screen: screen('x') },
+			'/c.ts': { screen: { id: 'nope' } },
+			'/d.ts': { screen: screen('y', { group: 'weird' as never }) }
+		});
+		expect(found).toEqual([first]);
+		expect(console.error).toHaveBeenCalledTimes(3);
+	});
+
+	it('registers this slice’s screens and S-keys’ file as it is', () => {
+		const ids = registered.map((s) => s.id);
+		expect(ids).toEqual(
+			expect.arrayContaining(['crawler', 'network', 'storage', 'search', 'general'])
+		);
+		expect(ids).toContain('keyboard');
+		expect(new Set(ids).size).toBe(ids.length);
+	});
+
+	it('keeps every screen.ts to types, messages and icons (it ships in every Settings page)', async () => {
+		const files = import.meta.glob(
+			['/src/lib/features/*/screen.ts', '/src/lib/features/*/*/screen.ts'],
+			{ query: '?raw', import: 'default', eager: true }
+		) as Record<string, string>;
+		expect(Object.keys(files).length).toBeGreaterThanOrEqual(2);
+		const allowed = (spec: string) =>
+			spec === '$lib/paraglide/messages.js' || spec.startsWith('~icons/ph/');
+		for (const [path, source] of Object.entries(files)) {
+			for (const m of source.matchAll(
+				/^\s*(import|export)\b(?!\s+type\b)[^;]*?\bfrom\s+['"]([^'"]+)['"]/gms
+			)) {
+				// A value import of a type-only module still counts; `import type` is erased.
+				expect(allowed(m[2]!), `${path} imports ${m[2]}`).toBe(true);
+			}
+			expect(source, `${path} has a dynamic import()`).not.toMatch(
+				/\bimport\s*\(\s*['"][^'"]*['"]\s*\)(?!\s*\})/
+			);
+		}
+	});
+});
+
+describe('order', () => {
+	it('follows the group order, then the id table, with unknown ids last by title', () => {
+		const sorted = sortScreens([
+			screen('about'),
+			screen('zeta', { group: 'system', title: () => 'Zeta' }),
+			screen('alpha', { group: 'system', title: () => 'Alpha' }),
+			screen('general'),
+			screen('network', { group: 'crawling' }),
+			screen('appearance', { group: 'preferences' }),
+			screen('crawler', { group: 'crawling' })
+		]);
+		expect(sorted.map((s) => s.id)).toEqual([
+			'appearance',
+			'crawler',
+			'network',
+			'general',
+			'about',
+			'alpha',
+			'zeta'
+		]);
+	});
+});
+
+describe('claims on the golden index', () => {
+	const index = goldenView();
+	const registry = buildRegistry(index);
+	const all = index.fieldsOf(index.sections.map((s) => s.section));
+
+	it('gives every field exactly one home', () => {
+		for (const spec of all) expect(registry.screenOf(spec.key), spec.key).toBeDefined();
+		const homed = registry.screens.flatMap((r) => r.keys);
+		expect(homed.sort()).toEqual(all.map((s) => s.key).sort());
+		expect(registry.doubleClaims.size).toBe(0);
+	});
+
+	it('puts Crawler on crawler + transport and Network, Storage, Search, General on theirs', () => {
+		const keys = (id: string) => registry.fieldsFor(id).map((s) => s.key);
+		expect(new Set(keys('crawler').map((k) => k.split('.')[0]))).toEqual(
+			new Set(['crawler', 'transport'])
+		);
+		expect(keys('network')).toHaveLength(4);
+		expect(keys('storage')).toEqual(['storage.mmap_mib', 'storage.archive_raw']);
+		expect(keys('search')).toEqual(['search.enabled', 'search.heap_mib']);
+		expect(keys('general')).toEqual(['general.data_dir']);
+	});
+
+	it('gives Keyboard its two preference fields through the fallback claim', () => {
+		expect(registry.fieldsFor('keyboard').map((s) => s.key)).toEqual([
+			'preferences.shortcuts',
+			'preferences.shortcut_keys'
+		]);
+		expect(registry.screenOf('preferences.shortcuts')?.screen.id).toBe('keyboard');
+	});
+
+	it('makes an interim screen per section nobody claims, in the right group and mode', () => {
+		const interim = registry.screens.filter((r) => r.interim);
+		expect(interim.map((r) => r.screen.id).sort()).toEqual([
+			'content',
+			'logging',
+			'preferences',
+			'updates'
+		]);
+		const by = Object.fromEntries(interim.map((r) => [r.screen.id, r]));
+		expect(by.preferences).toMatchObject({ mode: 'instant' });
+		expect(by.preferences!.screen.group).toBe('preferences');
+		expect(by.content!.screen.group).toBe('preferences');
+		expect(by.logging).toMatchObject({ mode: 'staged' });
+		expect(by.logging!.screen.group).toBe('system');
+		// The preferences screen leaves out the keyboard fields.
+		expect(by.preferences!.keys).not.toContain('preferences.shortcuts');
+		expect(by.preferences!.keys).toContain('preferences.theme');
+	});
+
+	it('stages every claimed non-preferences screen and orders the navigation', () => {
+		expect(registry.get('crawler')?.mode).toBe('staged');
+		const ids = registry.screens.map((r) => r.screen.id);
+		expect(ids.indexOf('crawler')).toBeLessThan(ids.indexOf('network'));
+		expect(ids.indexOf('network')).toBeLessThan(ids.indexOf('storage'));
+		expect(ids.indexOf('general')).toBeLessThan(ids.indexOf('logging'));
+	});
+
+	it('makes an interim screen disappear once a screen claims its fields', () => {
+		const claimed = buildRegistry(index, [
+			...registered,
+			screen('appearance', {
+				group: 'preferences',
+				sections: ['preferences'],
+				groups: ['appearance']
+			})
+		]);
+		expect(claimed.screenOf('preferences.theme')?.screen.id).toBe('appearance');
+		expect(claimed.get('preferences')?.keys).toEqual(
+			expect.not.arrayContaining(['preferences.theme'])
+		);
+	});
+
+	it('fails on two screens claiming one field', () => {
+		const twice = buildRegistry(index, [
+			...registered,
+			screen('dup', { group: 'crawling', sections: ['network'] })
+		]);
+		expect(twice.doubleClaims.get('network.http_bind')).toEqual(['network', 'dup']);
+		expect(console.error).toHaveBeenCalled();
+	});
+
+	it('resolves fieldsFor(screen, index) like the registry does', () => {
+		const network = mine.find((s) => s.id === 'network')!;
+		expect(fieldsFor(network, index).map((s) => s.key)).toEqual(
+			registry.fieldsFor('network').map((s) => s.key)
+		);
+	});
+
+	it('knows only the registered screens before the schema arrives', () => {
+		const early = buildRegistry(undefined);
+		expect(early.screens.length).toBe(registered.length);
+		expect(early.fieldsFor('crawler')).toEqual([]);
+	});
+});
+
+describe('aliases', () => {
+	it('sends backup and import to General’s backup section', () => {
+		expect(ALIASES).toEqual({
+			backup: '/settings/general#backup',
+			import: '/settings/general#backup'
+		});
+	});
+});
diff --git a/web/src/lib/features/settings/shell/registry.ts b/web/src/lib/features/settings/shell/registry.ts
new file mode 100644
index 00000000..27c48b43
--- /dev/null
+++ b/web/src/lib/features/settings/shell/registry.ts
@@ -0,0 +1,302 @@
+// The Settings screen registry (§10.10.2, §10.10.8): which screens exist, in which group and
+// order, and which one each schema field lives on. Features register a screen by exporting it
+// from a tiny `screen.ts` (README.md); everything the schema has that no screen claims gets an
+// interim generated screen, so a new server setting is never unreachable (§10.10.1).
+import type { Component } from 'svelte';
+import type { components } from '$lib/api/schema';
+import { currentLocale } from '$lib/i18n/locale.svelte';
+import type { SettingsIndexView } from '../form/schema';
+import { settingText } from '../form/messages';
+import type { FieldKey, FieldSpec } from '../form/types';
+
+export type ScreenGroup = 'preferences' | 'crawling' | 'library' | 'connections' | 'system';
+
+export interface SettingsScreen {
+	/** The URL segment: `/settings/<id>`. */
+	id: string;
+	group: ScreenGroup;
+	title: () => string;
+	/** A hand-built screen, loaded on open; it renders its own `<h1 tabindex="-1">`. */
+	load?: () => Promise<{ default: Component }>;
+	/** The schema sections whose fields it shows. */
+	sections?: readonly string[];
+	/** Only these `x-group`s of them (Keyboard: `['keyboard']`). */
+	groups?: readonly string[];
+	/** A `~icons/ph/*` import; the shell's gear when absent. */
+	icon?: Component;
+	/** A hand-built screen's own findable items (§10.10.3's static registry). */
+	search?: () => SearchEntry[];
+	/** Its Overview rows. */
+	attention?: (ctx: AttentionContext) => Promise<AttentionItem[]>;
+}
+
+export interface SearchEntry {
+	id: string;
+	label: () => string;
+	words?: () => string[];
+	anchor?: string;
+}
+
+export interface AttentionItem {
+	id: string;
+	screen: string;
+	severity: 'problem' | 'restart' | 'notice';
+	text: () => string;
+	action: { label: () => string; href?: string; run?: () => Promise<void> };
+}
+
+/** The `/system` the shell already fetched. */
+export interface AttentionContext {
+	system: components['schemas']['SystemInfo'];
+	signal: AbortSignal;
+}
+
+export const GROUPS: readonly ScreenGroup[] = [
+	'preferences',
+	'crawling',
+	'library',
+	'connections',
+	'system'
+];
+
+/** The order inside each group (§10.10.2); an id not listed goes last, by title. */
+export const SCREEN_ORDER: Record<ScreenGroup, readonly string[]> = {
+	preferences: ['appearance', 'keyboard', 'language'],
+	crawling: ['crawler', 'network', 'sources', 'workers', 'companions'],
+	library: ['storage', 'search', 'trackers', 'filters'],
+	connections: ['integrations', 'notifications', 'insights'],
+	system: ['general', 'updates', 'logging', 'security', 'about']
+};
+
+/** `preferences` is saved per account and applies instantly; every other section is staged. */
+export const INSTANT_SECTION = 'preferences';
+
+/** The group of an interim screen (a section no screen claims); anything else is System. */
+const INTERIM_GROUP: Record<string, ScreenGroup> = {
+	preferences: 'preferences',
+	content: 'preferences'
+};
+
+/**
+ * Fields a screen shows before its own `screen.ts` says so: S-keys' file declares no `sections`,
+ * so Keyboard keeps its two fields through this claim.
+ * TODO(shortcuts): move this into features/shortcuts/screen.ts and delete it here.
+ */
+const FALLBACK_CLAIMS: Record<string, { sections: readonly string[]; groups: readonly string[] }> =
+	{ keyboard: { sections: ['preferences'], groups: ['keyboard'] } };
+
+/** Aliases the shell's More menu links to (`lib/shell/nav.ts`). */
+export const ALIASES: Record<string, string> = {
+	backup: '/settings/general#backup',
+	import: '/settings/general#backup'
+};
+
+// --- discovery -------------------------------------------------------------------------------
+
+const isScreen = (v: unknown): v is SettingsScreen =>
+	typeof v === 'object' &&
+	v !== null &&
+	typeof (v as SettingsScreen).id === 'string' &&
+	typeof (v as SettingsScreen).group === 'string' &&
+	typeof (v as SettingsScreen).title === 'function';
+
+function devError(message: string) {
+	if (import.meta.env.DEV) console.error(`settings: ${message}`);
+}
+
+/**
+ * The screens in these modules: a module exports `screen` (one), `screens` (several) or a default
+ * of either. One screen exported under two names counts once; a repeated id keeps the first.
+ */
+export function collect(modules: Record<string, unknown>): SettingsScreen[] {
+	const seen = new Set<unknown>();
+	const ids = new Set<string>();
+	const out: SettingsScreen[] = [];
+	const take = (value: unknown, from: string) => {
+		for (const v of Array.isArray(value) ? value : [value]) {
+			if (v === undefined || seen.has(v)) continue;
+			seen.add(v);
+			if (!isScreen(v)) {
+				devError(`${from} exports something that isn't a SettingsScreen`);
+			} else if (!GROUPS.includes(v.group)) {
+				devError(`${from}: screen "${v.id}" has an unknown group "${v.group}"`);
+			} else if (ids.has(v.id)) {
+				devError(`${from}: screen id "${v.id}" is registered twice`);
+			} else {
+				ids.add(v.id);
+				out.push(v);
+			}
+		}
+	};
+	for (const [path, mod] of Object.entries(modules)) {
+		const m = (mod ?? {}) as Record<string, unknown>;
+		take(m.screens, path);
+		take(m.screen, path);
+		take(m.default, path);
+	}
+	return out;
+}
+
+/** Every `screen.ts` of a feature folder (`features/<f>/screen.ts` or `features/<f>/<g>/screen.ts`). */
+export const registered: SettingsScreen[] = collect(
+	import.meta.glob(['/src/lib/features/*/screen.ts', '/src/lib/features/*/*/screen.ts'], {
+		eager: true
+	})
+);
+
+// --- order -----------------------------------------------------------------------------------
+
+/** Navigation order: group order, then the id table, then unlisted ids last by title. */
+export function sortScreens<T extends { group: ScreenGroup; id: string; title: () => string }>(
+	screens: readonly T[]
+): T[] {
+	const rank = (s: T) => {
+		const at = SCREEN_ORDER[s.group].indexOf(s.id);
+		return at < 0 ? SCREEN_ORDER[s.group].length : at;
+	};
+	return [...screens].sort(
+		(a, b) =>
+			GROUPS.indexOf(a.group) - GROUPS.indexOf(b.group) ||
+			rank(a) - rank(b) ||
+			a.title().localeCompare(b.title(), currentLocale())
+	);
+}
+
+// --- resolving -------------------------------------------------------------------------------
+
+export interface ResolvedScreen {
+	screen: SettingsScreen;
+	/** Made for a section no screen claims; disappears when its slice claims the fields. */
+	interim: boolean;
+	/** Preferences save instantly; everything else is staged and saved together. */
+	mode: 'staged' | 'instant';
+	/** The fields it shows, in schema order. */
+	keys: FieldKey[];
+}
+
+export interface Registry {
+	/** In navigation order. */
+	readonly screens: readonly ResolvedScreen[];
+	/** Fields claimed by more than one screen (a dev error): `key → the screens`. */
+	readonly doubleClaims: ReadonlyMap<FieldKey, string[]>;
+	get(id: string): ResolvedScreen | undefined;
+	/** The fields a screen shows, in schema order. */
+	fieldsFor(screen: SettingsScreen | string): FieldSpec[];
+	/** The screen a field lives on. */
+	screenOf(key: FieldKey): ResolvedScreen | undefined;
+}
+
+function claims(screen: SettingsScreen) {
+	if (screen.sections) return { sections: screen.sections, groups: screen.groups };
+	return FALLBACK_CLAIMS[screen.id];
+}
+
+/**
+ * Resolves the screens against the schema: each field goes to the first registered screen that
+ * claims it, and the fields nobody claims form an interim generated screen per section. Without
+ * an index (still loading) only the registered screens are known.
+ */
+export function buildRegistry(
+	index: SettingsIndexView | undefined,
+	screens: readonly SettingsScreen[] = registered
+): Registry {
+	const owner = new Map<FieldKey, SettingsScreen>();
+	const doubleClaims = new Map<FieldKey, string[]>();
+	const keysOf = new Map<string, FieldKey[]>();
+	const specOf = new Map<FieldKey, FieldSpec>();
+	const unclaimed: FieldSpec[] = [];
+	const ordered = sortScreens(screens);
+
+	if (index) {
+		for (const section of index.sections) {
+			for (const spec of index.fieldsOf([section.section])) {
+				specOf.set(spec.key, spec);
+				let first: SettingsScreen | undefined;
+				for (const screen of ordered) {
+					const c = claims(screen);
+					if (!c?.sections.includes(spec.section)) continue;
+					if (c.groups && !c.groups.includes(spec.group)) continue;
+					if (!first) first = screen;
+					else if (first !== screen) {
+						const names = doubleClaims.get(spec.key) ?? [first.id];
+						names.push(screen.id);
+						doubleClaims.set(spec.key, names);
+					}
+				}
+				if (first) {
+					owner.set(spec.key, first);
+					(keysOf.get(first.id) ?? keysOf.set(first.id, []).get(first.id)!).push(spec.key);
+				} else unclaimed.push(spec);
+			}
+		}
+		for (const [key, names] of doubleClaims)
+			devError(`${key} is claimed by ${names.join(' and ')}`);
+	}
+
+	const resolved: ResolvedScreen[] = ordered.map((screen) => ({
+		screen,
+		interim: false,
+		mode: instantFor(screen.sections),
+		keys: keysOf.get(screen.id) ?? []
+	}));
+
+	const registeredIds = new Set(ordered.map((s) => s.id));
+	const bySection = new Map<string, FieldSpec[]>();
+	for (const spec of unclaimed)
+		(bySection.get(spec.section) ?? bySection.set(spec.section, []).get(spec.section)!).push(spec);
+	const interim: ResolvedScreen[] = [];
+	for (const [section, specs] of bySection) {
+		if (registeredIds.has(section)) {
+			devError(`section "${section}" has unclaimed fields but a screen already uses its id`);
+			continue;
+		}
+		const label = index!.sections.find((s) => s.section === section)?.labelKey;
+		interim.push({
+			interim: true,
+			mode: instantFor([section]),
+			keys: specs.map((s) => s.key),
+			screen: {
+				id: section,
+				group: INTERIM_GROUP[section] ?? 'system',
+				title: () => (label ? settingText(label) : undefined) ?? section,
+				sections: [section]
+			}
+		});
+	}
+
+	const all = [...resolved, ...interim];
+	const sortedAll = sortScreens(all.map((r) => ({ ...r.screen, r }))).map((x) => x.r);
+	const byId = new Map(sortedAll.map((r) => [r.screen.id, r]));
+	for (const r of sortedAll) for (const key of r.keys) owner.set(key, r.screen);
+
+	return {
+		screens: sortedAll,
+		doubleClaims,
+		get: (id) => byId.get(id),
+		fieldsFor: (screen) => {
+			const r = byId.get(typeof screen === 'string' ? screen : screen.id);
+			return (r?.keys ?? []).flatMap((k) => specOf.get(k) ?? []);
+		},
+		screenOf: (key) => {
+			const s = owner.get(key);
+			return s ? byId.get(s.id) : undefined;
+		}
+	};
+}
+
+function instantFor(sections: readonly string[] | undefined): 'staged' | 'instant' {
+	return sections && sections.length > 0 && sections.every((s) => s === INSTANT_SECTION)
+		? 'instant'
+		: 'staged';
+}
+
+/** `fieldsFor(screen, index)`: a screen's fields without keeping a registry around. */
+export function fieldsFor(
+	screen: SettingsScreen,
+	index: SettingsIndexView,
+	screens: readonly SettingsScreen[] = registered
+): FieldSpec[] {
+	return buildRegistry(index, screens.includes(screen) ? screens : [...screens, screen]).fieldsFor(
+		screen
+	);
+}
diff --git a/web/src/lib/features/settings/shell/restart-flow.ts b/web/src/lib/features/settings/shell/restart-flow.ts
new file mode 100644
index 00000000..02e374ed
--- /dev/null
+++ b/web/src/lib/features/settings/shell/restart-flow.ts
@@ -0,0 +1,66 @@
+// "Restart now" and the address keep-or-revert calls (§10.10.6), loaded when used. The restart
+// asks first (`ask()`: crawling pauses), then `POST /system/restart`, then hands over to the
+// full-page waiting state (`RestartingScreen.svelte`) through `flow`.
+import { ApiError, api } from '$lib/api/client';
+import { formatSpan } from '$lib/format';
+import { currentLocale } from '$lib/i18n/locale.svelte';
+import { m } from '$lib/paraglide/messages.js';
+import { toast } from '$lib/ui/feedback/toasts.svelte';
+import { ask } from '../form/dialogs';
+import type { SystemInfo } from './system';
+import { startWaiting } from './flow.svelte';
+
+/** Asks, then restarts. Resolves once the request is answered (the waiting state takes over). */
+export async function restartNow(system: SystemInfo, signal?: AbortSignal): Promise<void> {
+	const time = formatSpan(system.restart.estimated_seconds, currentLocale());
+	const answer = await ask(
+		{
+			title: m.settings_ui_confirm_title(),
+			body: [m.settings_ui_confirm_body({ time })],
+			actions: [
+				{ id: 'cancel', label: m.settings_form_cancel() },
+				{ id: 'restart', label: m.settings_ui_confirm_restart(), variant: 'danger' }
+			],
+			initial: 'cancel'
+		},
+		signal
+	);
+	if (answer !== 'restart') return;
+	try {
+		const accepted = await api.post('/system/restart');
+		// A pending address change moves the page to the new address once it answers.
+		const change = system.address_change;
+		startWaiting({
+			to: change?.state === 'awaiting_restart' ? change.url : undefined,
+			estimate: accepted.estimated_seconds,
+			before: system.started_at
+		});
+	} catch (e) {
+		if (e instanceof ApiError && e.code === 'restart_unavailable') {
+			toast.push({
+				kind: 'error',
+				text: m.settings_ui_restart_unavailable({ hint: e.message })
+			});
+		} else toast.push({ kind: 'error', text: m.settings_ui_restart_failed() });
+	}
+}
+
+/** `POST /system/address/keep`: the new address stays. Returns the change as it is now. */
+export const keepAddress = () => api.post('/system/address/keep');
+
+/**
+ * `POST /system/address/revert`. When the server restarts onto the previous address, the waiting
+ * state moves the page there.
+ */
+export async function revertAddress(system: SystemInfo) {
+	const outcome = await api.post('/system/address/revert');
+	const previous = system.address_change?.previous_url;
+	if (outcome.restarting && previous) {
+		startWaiting({
+			to: previous,
+			estimate: system.restart.estimated_seconds,
+			before: system.started_at
+		});
+	}
+	return outcome;
+}
diff --git a/web/src/lib/features/settings/shell/restart.test.ts b/web/src/lib/features/settings/shell/restart.test.ts
new file mode 100644
index 00000000..5673f249
--- /dev/null
+++ b/web/src/lib/features/settings/shell/restart.test.ts
@@ -0,0 +1,140 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { ApiError } from '$lib/api/client';
+import { backoff, GIVE_UP_MS, pollUntil, restartedHere, upAt } from './restart';
+
+const system = vi.hoisted(() => ({ get: vi.fn() }));
+vi.mock('$lib/api/client', async (actual) => ({
+	...(await actual<typeof import('$lib/api/client')>()),
+	api: { get: system.get }
+}));
+
+afterEach(() => vi.clearAllMocks());
+
+/** A clock the fake sleep advances. */
+function clock() {
+	let t = 0;
+	const waits: number[] = [];
+	return {
+		waits,
+		now: () => t,
+		sleep: async (ms: number) => {
+			waits.push(ms);
+			t += ms;
+		}
+	};
+}
+
+describe('backoff', () => {
+	it('doubles from 1 s to 8 s and stays there', () => {
+		expect([0, 1, 2, 3, 4, 9].map(backoff)).toEqual([1000, 2000, 4000, 8000, 8000, 8000]);
+	});
+});
+
+describe('pollUntil', () => {
+	it('answers up as soon as the check does, waiting 1 s, 2 s, 4 s between tries', async () => {
+		const c = clock();
+		let tries = 0;
+		const out = await pollUntil(async () => ++tries === 4, c);
+		expect(out).toBe('up');
+		expect(c.waits).toEqual([1000, 2000, 4000]);
+	});
+
+	it('counts a failing check as not yet', async () => {
+		const c = clock();
+		let tries = 0;
+		const out = await pollUntil(async () => {
+			if (++tries < 3) throw new TypeError('Failed to fetch');
+			return true;
+		}, c);
+		expect(out).toBe('up');
+	});
+
+	it('gives up after two minutes', async () => {
+		const c = clock();
+		const out = await pollUntil(async () => false, c);
+		expect(out).toBe('timeout');
+		expect(c.waits.reduce((a, b) => a + b, 0)).toBeGreaterThanOrEqual(GIVE_UP_MS);
+		expect(c.waits.at(-1)).toBe(8000);
+	});
+
+	it('stops when aborted', async () => {
+		const ctl = new AbortController();
+		const out = await pollUntil(
+			async () => {
+				ctl.abort();
+				return false;
+			},
+			{ ...clock(), signal: ctl.signal }
+		);
+		expect(out).toBe('aborted');
+	});
+});
+
+describe('restartedHere', () => {
+	const ok = { ok: true } as Response;
+	const bad = { ok: false } as Response;
+
+	it('is not restarted while the old process still has the same start time', async () => {
+		system.get.mockResolvedValue({ started_at: 100 });
+		expect(
+			await restartedHere(
+				100,
+				vi.fn(async () => ok)
+			)()
+		).toBe(false);
+	});
+
+	it('is restarted once /healthz answers and the start time moved', async () => {
+		system.get.mockResolvedValue({ started_at: 160 });
+		expect(
+			await restartedHere(
+				100,
+				vi.fn(async () => ok)
+			)()
+		).toBe(true);
+	});
+
+	it('waits while /healthz answers with an error', async () => {
+		expect(
+			await restartedHere(
+				100,
+				vi.fn(async () => bad)
+			)()
+		).toBe(false);
+		expect(system.get).not.toHaveBeenCalled();
+	});
+
+	it('waits while /system fails with a network or server error, and counts a 401 as up', async () => {
+		const fetcher = vi.fn(async () => ok);
+		system.get.mockRejectedValueOnce(new ApiError(0, 'network', 'offline'));
+		expect(await restartedHere(100, fetcher)()).toBe(false);
+		system.get.mockRejectedValueOnce(new ApiError(503, 'unavailable', 'starting'));
+		expect(await restartedHere(100, fetcher)()).toBe(false);
+		system.get.mockRejectedValueOnce(new ApiError(401, 'login_required', 'sign in'));
+		expect(await restartedHere(100, fetcher)()).toBe(true);
+	});
+});
+
+describe('upAt', () => {
+	it('asks the new address’s /healthz with no-cors, and any answer is up', async () => {
+		const fetcher = vi.fn(
+			async () => ({ type: 'opaque', ok: false, status: 0 }) as unknown as Response
+		);
+		expect(await upAt('http://192.168.1.5:9090', fetcher as never)()).toBe(true);
+		expect(fetcher).toHaveBeenCalledWith(new URL('http://192.168.1.5:9090/healthz'), {
+			mode: 'no-cors',
+			cache: 'no-store'
+		});
+	});
+
+	it('fails (so polling goes on) when nothing is listening yet', async () => {
+		const fetcher = vi.fn(async () => Promise.reject(new TypeError('Failed to fetch')));
+		await expect(upAt('http://192.168.1.5:9090', fetcher as never)()).rejects.toThrow();
+	});
+
+	it('never asks an address that is not http(s)', async () => {
+		const fetcher = vi.fn();
+		expect(await upAt('javascript:alert(1)', fetcher as never)()).toBe(false);
+		expect(fetcher).not.toHaveBeenCalled();
+	});
+});
diff --git a/web/src/lib/features/settings/shell/restart.ts b/web/src/lib/features/settings/shell/restart.ts
new file mode 100644
index 00000000..fbe8d71b
--- /dev/null
+++ b/web/src/lib/features/settings/shell/restart.ts
@@ -0,0 +1,84 @@
+// Restarting Lodestar and finding it again (§10.10.6). `POST /system/restart` answers first; the
+// server then goes down and comes back, so the client polls: `/healthz` with a growing wait
+// (1 s doubling to 8 s) for up to 2 minutes. A same-origin answer isn't proof by itself, since the
+// old process can still answer until it shuts down: `waitForRestart` also compares `started_at`.
+import { api } from '$lib/api/client';
+import { healthUrl } from './urls';
+
+export const BACKOFF_START_MS = 1_000;
+export const BACKOFF_CAP_MS = 8_000;
+export const GIVE_UP_MS = 120_000;
+
+/** 1 s, 2 s, 4 s, 8 s, 8 s, … */
+export const backoff = (attempt: number): number =>
+	Math.min(BACKOFF_CAP_MS, BACKOFF_START_MS * 2 ** attempt);
+
+export interface Wait {
+	/** Called between attempts, to learn how long it has been. Defaults to the clock. */
+	now?: () => number;
+	/** Resolves after `ms`; replaced by tests. */
+	sleep?: (ms: number, signal?: AbortSignal) => Promise<void>;
+	signal?: AbortSignal;
+}
+
+function defaultSleep(ms: number, signal?: AbortSignal): Promise<void> {
+	return new Promise((resolve) => {
+		const timer = setTimeout(resolve, ms);
+		signal?.addEventListener(
+			'abort',
+			() => {
+				clearTimeout(timer);
+				resolve();
+			},
+			{ once: true }
+		);
+	});
+}
+
+export type Outcome = 'up' | 'timeout' | 'aborted';
+
+/** Polls `attempt()` (true when the server is back) with the backoff, until the deadline. */
+export async function pollUntil(attempt: () => Promise<boolean>, w: Wait = {}): Promise<Outcome> {
+	const now = w.now ?? Date.now;
+	const sleep = w.sleep ?? defaultSleep;
+	const start = now();
+	for (let n = 0; ; n++) {
+		if (w.signal?.aborted) return 'aborted';
+		if (await attempt().catch(() => false)) return 'up';
+		if (w.signal?.aborted) return 'aborted';
+		if (now() - start >= GIVE_UP_MS) return 'timeout';
+		await sleep(backoff(n), w.signal);
+	}
+}
+
+/**
+ * This server is back after a restart: `/healthz` answers and `/system` shows a newer start
+ * (`started_at`). When `/system` can't be read (the session is gone) the answer alone counts.
+ */
+export function restartedHere(before: number, fetcher: typeof fetch = fetch) {
+	return async (): Promise<boolean> => {
+		const res = await fetcher('/healthz', { cache: 'no-store' });
+		if (!res.ok) return false;
+		try {
+			const system = await api.get('/system');
+			return system.started_at !== before;
+		} catch (e) {
+			// Still starting up (`network`, 5xx): not yet. Anything else (a 401): it's up.
+			const status = (e as { status?: number }).status ?? 0;
+			return status !== 0 && status < 500;
+		}
+	};
+}
+
+/**
+ * Another address is up. A cross-origin `fetch` is opaque with `no-cors`: any answer at all means
+ * a server is listening there, which is all a move to a new address needs.
+ */
+export function upAt(address: string, fetcher: typeof fetch = fetch) {
+	return async (): Promise<boolean> => {
+		const url = healthUrl(address);
+		if (!url) return false;
+		await fetcher(url, { mode: 'no-cors', cache: 'no-store' });
+		return true;
+	};
+}
diff --git a/web/src/lib/features/settings/shell/search.test.ts b/web/src/lib/features/settings/shell/search.test.ts
