diff --git a/web/src/lib/features/settings/shell/search.ts b/web/src/lib/features/settings/shell/search.ts
new file mode 100644
index 00000000..4f3a3257
--- /dev/null
+++ b/web/src/lib/features/settings/shell/search.ts
@@ -0,0 +1,158 @@
+// Settings search (§10.10.3): an in-house index over every field of every screen and the
+// hand-built screens' own entries. Case- and accent-insensitive, matching on word prefixes in the
+// current locale; a label match ranks above a keyword, config key or variable match, above the
+// group, above the help. Loaded when the search box is first focused.
+import { m } from '$lib/paraglide/messages.js';
+import type { FieldKey, FieldSpec } from '../form/types';
+import { fieldHelp, fieldLabel, settingText } from '../form/messages';
+import { groupHeading } from './groups';
+import type { Registry } from './registry';
+
+export interface SearchItem {
+	id: string;
+	kind: 'screen' | 'field' | 'entry';
+	screenId: string;
+	/** The field, for a schema field. */
+	key?: FieldKey;
+	spec?: FieldSpec;
+	/** The hash to open: the field key, or a hand-built screen's own anchor. */
+	anchor?: string;
+	label: string;
+	help?: string;
+	/** "Crawling › Crawler › Advanced". */
+	crumb: string;
+	/** Keywords, the `config.toml` key and the `LODESTAR_*` name. */
+	names: string[];
+	group?: string;
+}
+
+export interface Hit {
+	item: SearchItem;
+	score: number;
+}
+
+const COMBINING = /\p{M}/gu;
+const SPLIT = /[^\p{L}\p{N}]+/u;
+const CJK = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u;
+
+/** NFD, combining marks dropped, lower-cased in `locale`: "Éclair" and "eclair" are the same. */
+export function normalize(text: string, locale = 'en'): string {
+	return text.normalize('NFD').replace(COMBINING, '').toLocaleLowerCase(locale);
+}
+
+/**
+ * The words a text can be found by: its alphanumeric runs, plus a whole `a.b` / `A_B` name, so
+ * both "dht" and "dht_port" find `LODESTAR_DHT_PORT`.
+ */
+export function wordsOf(text: string, locale = 'en'): string[] {
+	const n = normalize(text, locale);
+	const parts = n.split(SPLIT).filter(Boolean);
+	const whole = n.split(/[\s,;]+/).filter((w) => /[._-]/.test(w));
+	return [...new Set([...parts, ...whole])];
+}
+
+const hasPrefix = (words: string[], q: string) => words.some((w) => w.startsWith(q));
+
+export interface SearchIndex {
+	items: readonly SearchItem[];
+	search(query: string): Hit[];
+}
+
+interface Prepared {
+	item: SearchItem;
+	label: string;
+	labelWords: string[];
+	nameWords: string[];
+	groupWords: string[];
+	helpWords: string[];
+	help: string;
+}
+
+export function createIndex(items: readonly SearchItem[], locale = 'en'): SearchIndex {
+	const prepared: Prepared[] = items.map((item) => ({
+		item,
+		label: normalize(item.label, locale),
+		labelWords: wordsOf(item.label, locale),
+		nameWords: item.names.flatMap((n) => wordsOf(n, locale)),
+		groupWords: wordsOf(`${item.group ?? ''} ${item.crumb}`, locale),
+		helpWords: wordsOf(item.help ?? '', locale),
+		help: normalize(item.help ?? '', locale)
+	}));
+	return {
+		items,
+		search(query) {
+			const qs = normalize(query, locale).split(SPLIT).filter(Boolean);
+			if (qs.length === 0) return [];
+			const hits: Hit[] = [];
+			for (const p of prepared) {
+				let score = 0;
+				let all = true;
+				for (const q of qs) {
+					const cjk = CJK.test(q);
+					let s = 0;
+					if (hasPrefix(p.labelWords, q) || (cjk && p.label.includes(q))) {
+						s = p.labelWords[0]?.startsWith(q) ? 120 : 100;
+					} else if (hasPrefix(p.nameWords, q)) s = 60;
+					else if (hasPrefix(p.groupWords, q)) s = 40;
+					else if (hasPrefix(p.helpWords, q) || (cjk && p.help.includes(q))) s = 20;
+					if (s === 0) {
+						all = false;
+						break;
+					}
+					score += s;
+				}
+				if (!all) continue;
+				// A label that is exactly the query is the best answer.
+				if (p.label === normalize(query.trim(), locale)) score += 200;
+				hits.push({ item: p.item, score });
+			}
+			// Stable: the index is in screen order, so equal scores keep it.
+			return hits.sort((a, b) => b.score - a.score);
+		}
+	};
+}
+
+/** Every searchable thing in the registry, in screen order. */
+export function buildItems(registry: Registry): SearchItem[] {
+	const items: SearchItem[] = [];
+	for (const r of registry.screens) {
+		const group = groupHeading[r.screen.group]();
+		const title = r.screen.title();
+		items.push({
+			id: `screen:${r.screen.id}`,
+			kind: 'screen',
+			screenId: r.screen.id,
+			label: title,
+			crumb: `${group} › ${title}`,
+			names: [r.screen.id]
+		});
+		for (const spec of registry.fieldsFor(r.screen.id)) {
+			const keywords = spec.keywordsKey ? (settingText(spec.keywordsKey) ?? '') : '';
+			items.push({
+				id: spec.key,
+				kind: 'field',
+				screenId: r.screen.id,
+				key: spec.key,
+				spec,
+				anchor: spec.key,
+				label: fieldLabel(spec),
+				help: fieldHelp(spec),
+				crumb: `${group} › ${title}${spec.advanced ? ` › ${m.settings_ui_crumb_advanced()}` : ''}`,
+				names: [...keywords.split(','), spec.config ?? '', spec.env ?? ''].filter(Boolean),
+				group: settingText(`settings.group.${spec.group}`)
+			});
+		}
+		for (const entry of r.screen.search?.() ?? []) {
+			items.push({
+				id: `${r.screen.id}:${entry.id}`,
+				kind: 'entry',
+				screenId: r.screen.id,
+				anchor: entry.anchor,
+				label: entry.label(),
+				names: entry.words?.() ?? [],
+				crumb: `${group} › ${title}`
+			});
+		}
+	}
+	return items;
+}
diff --git a/web/src/lib/features/settings/shell/state.svelte.ts b/web/src/lib/features/settings/shell/state.svelte.ts
new file mode 100644
index 00000000..b84c3d7c
--- /dev/null
+++ b/web/src/lib/features/settings/shell/state.svelte.ts
@@ -0,0 +1,142 @@
+// What the Settings layout shares with its pages: the schema index, the registry resolved from
+// it, `/system` (restart, address change, what's changed), the Overview's attention items and the
+// navigation's badges, and whether the two panes fit (x-large, §10.10.2). The layout creates it;
+// pages read it. Attention and its providers load lazily, once `/system` and the schema are in.
+import { getContext, setContext } from 'svelte';
+import { MediaQuery } from 'svelte/reactivity';
+import { api, isAbort } from '$lib/api/client';
+import { loadSettingMessages } from '../form/messages';
+import type { SettingsIndexView } from '../form/schema';
+import { loadSettingsIndex } from '../form/schema';
+import { buildBadges, type Badge } from './badges';
+import { buildRegistry, type AttentionItem, type Registry } from './registry';
+import type { SystemInfo } from './system';
+
+const KEY = Symbol('settings');
+
+/** x-large and wider (`--breakpoint-x-large`, 1024 px): navigation and screen side by side. */
+const WIDE = '(min-width: 64rem)';
+
+type Status = 'loading' | 'ready' | 'failed';
+
+export interface SettingsState {
+	readonly status: Status;
+	readonly index: SettingsIndexView | undefined;
+	readonly registry: Registry;
+	/** Two panes (x-large and wider); below it the list and a screen take turns. */
+	readonly wide: boolean;
+	retry(): void;
+	/** `GET /system`, fetched once by the layout and refreshed on `settings` events. */
+	readonly system: SystemInfo | undefined;
+	readonly systemStatus: Status;
+	refreshSystem(): Promise<void>;
+	/** The Overview's rows; `ready` once every provider has answered. */
+	readonly attention: { ready: boolean; items: AttentionItem[]; partial: boolean };
+	readonly badges: Record<string, Badge>;
+}
+
+export function createSettingsState(): SettingsState {
+	let status = $state<Status>('loading');
+	let index = $state.raw<SettingsIndexView>();
+	const registry = $derived(buildRegistry(index));
+	let system = $state.raw<SystemInfo>();
+	let systemStatus = $state<Status>('loading');
+	let attention = $state.raw({ ready: false, items: [] as AttentionItem[], partial: false });
+	// A MediaQuery is reactive in a component; without `matchMedia` (a test) the panes stack.
+	const media = typeof matchMedia === 'function' ? new MediaQuery(WIDE) : undefined;
+
+	let seq = 0;
+	let ctl: AbortController | undefined;
+	/** Runs the providers against the latest `/system` and schema; a newer run supersedes this one. */
+	async function recompute() {
+		if (!system || !index) return;
+		const mine = ++seq;
+		ctl?.abort();
+		const c = (ctl = new AbortController());
+		try {
+			const { collectAttention } = await import('./attention');
+			const result = await collectAttention({ system, registry, signal: c.signal });
+			if (mine === seq) attention = { ready: true, ...result };
+		} catch (e) {
+			if (!isAbort(e) && mine === seq) attention = { ready: true, items: [], partial: true };
+		}
+	}
+
+	function load() {
+		status = 'loading';
+		// The group headings and each section's label (an interim screen's title) come with it.
+		Promise.all([loadSettingsIndex(), loadSettingMessages([])]).then(
+			([i]) => {
+				index = i;
+				status = 'ready';
+				void recompute();
+			},
+			() => (status = 'failed')
+		);
+	}
+
+	async function refreshSystem() {
+		try {
+			system = await api.get('/system');
+			systemStatus = 'ready';
+			void recompute();
+		} catch (e) {
+			// A refresh that fails keeps what was shown; only the first load is a failure.
+			if (!isAbort(e) && !system) systemStatus = 'failed';
+		}
+	}
+	function retry() {
+		if (status === 'failed') load();
+		if (systemStatus === 'failed') {
+			systemStatus = 'loading';
+			void refreshSystem();
+		}
+	}
+	load();
+	void refreshSystem();
+
+	const badges = $derived(
+		attention.ready || system
+			? buildBadges(attention.items, system?.restart_required ?? [], registry)
+			: {}
+	);
+
+	return {
+		get status() {
+			return status;
+		},
+		get index() {
+			return index;
+		},
+		get registry() {
+			return registry;
+		},
+		get wide() {
+			return media?.current ?? false;
+		},
+		retry,
+		get system() {
+			return system;
+		},
+		get systemStatus() {
+			return systemStatus;
+		},
+		refreshSystem,
+		get attention() {
+			return attention;
+		},
+		get badges() {
+			return badges;
+		}
+	};
+}
+
+export function provideSettings(state: SettingsState): SettingsState {
+	return setContext(KEY, state);
+}
+
+export function useSettings(): SettingsState {
+	const state = getContext<SettingsState | undefined>(KEY);
+	if (!state) throw new Error('useSettings() outside the Settings layout');
+	return state;
+}
