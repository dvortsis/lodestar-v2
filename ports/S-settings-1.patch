@@ -0,0 +1,43 @@
+<script lang="ts">
+	// General (§10.10.8): the generated fields, then Backup & portability (`#backup`) and the
+	// Danger zone. The panels are lazy; a `#backup` link scrolls to the section once it is there.
+	import { page } from '$app/state';
+	import { m } from '$lib/paraglide/messages.js';
+	import { tick, type Component } from 'svelte';
+	import type { ResolvedScreen } from '../shell/registry';
+	import DangerZone from './DangerZone.svelte';
+	import GeneratedScreen from './GeneratedScreen.svelte';
+
+	let { resolved }: { resolved: ResolvedScreen } = $props();
+
+	let Backup = $state.raw<Component>();
+	void import('./BackupPanel.svelte').then((mod) => (Backup = mod.default));
+
+	let section = $state<HTMLElement>();
+	$effect(() => {
+		if (page.url.hash !== '#backup' || !Backup || !section) return;
+		void tick().then(() => {
+			section?.scrollIntoView?.({ block: 'start' });
+			section?.querySelector<HTMLElement>('h2')?.focus();
+		});
+	});
+</script>
+
+<GeneratedScreen {resolved}>
+	{#snippet footer()}
+		<section
+			id="backup"
+			bind:this={section}
+			class="flex flex-col gap-4"
+			aria-labelledby="backup-title"
+			data-testid="settings-backup-section"
+		>
+			<h2 id="backup-title" tabindex="-1" class="text-title font-semibold outline-none">
+				{m.settings_ui_backup_title()}
+			</h2>
+			<p>{m.settings_ui_backup_lead()}</p>
+			{#if Backup}<Backup />{/if}
+		</section>
+		<DangerZone />
+	{/snippet}
+</GeneratedScreen>
diff --git a/web/src/lib/features/settings/screens/GeneratedScreen.svelte b/web/src/lib/features/settings/screens/GeneratedScreen.svelte
new file mode 100644
index 00000000..76ace6d5
--- /dev/null
+++ b/web/src/lib/features/settings/screens/GeneratedScreen.svelte
@@ -0,0 +1,129 @@
+<script lang="ts">
+	// A screen made from the schema (§10.10.2, §10.10.8): the heading and its one-sentence purpose,
+	// Show changed only, the groups, then anything the screen adds after them. This is the screen
+	// that creates the form, so it destroys it when it unmounts (SettingsForm.svelte only borrows
+	// it, and a re-mount must not lose its edits).
+	import { page } from '$app/state';
+	import { replaceState } from '$app/navigation';
+	import { m } from '$lib/paraglide/messages.js';
+	import Toggle from '$lib/ui/fields/Toggle.svelte';
+	import { onMount, untrack, type Component, type Snippet } from 'svelte';
+	import {
+		createSettingsForm,
+		loadSettingMessages,
+		settingText,
+		type FieldKey,
+		type FieldSpec,
+		type SettingsForm
+	} from '../form';
+	import SettingsFormView from '../form/SettingsForm.svelte';
+	import type { ResolvedScreen } from '../shell/registry';
+	import { useSettings } from '../shell/state.svelte';
+	import SettingsGroups from './SettingsGroups.svelte';
+
+	interface Props {
+		resolved: ResolvedScreen;
+		/** Extra content after a group (its id is the argument), and after all of them. */
+		afterGroup?: Snippet<[group: string]>;
+		footer?: Snippet;
+		/** Called with the form once it exists (Network registers its lockout dialog); returns its cleanup. */
+		oncreate?: (form: SettingsForm) => (() => void) | void;
+	}
+
+	let { resolved, afterGroup, footer, oncreate }: Props = $props();
+
+	const settings = useSettings();
+	const screen = untrack(() => resolved.screen);
+	const mode = untrack(() => resolved.mode);
+
+	const PURPOSE: Record<string, () => string> = {
+		crawler: m.settings_ui_screen_crawler_purpose,
+		network: m.settings_ui_screen_network_purpose,
+		storage: m.settings_ui_screen_storage_purpose,
+		search: m.settings_ui_screen_search_purpose,
+		general: m.settings_ui_screen_general_purpose
+	};
+	const purpose = $derived.by(() => {
+		const own = PURPOSE[screen.id];
+		if (own) return own();
+		const section = screen.sections?.[0];
+		const help = settings.index?.sections.find((s) => s.section === section)?.helpKey;
+		return help ? settingText(help) : undefined;
+	});
+
+	// "View as config.toml" comes in after the screen, so it is not part of its first view.
+	let Config = $state.raw<Component<{ form: SettingsForm; specs: FieldSpec[] }>>();
+	onMount(() => {
+		void import('./ConfigDisclosure.svelte').then((mod) => (Config = mod.default as never));
+	});
+
+	let form = $state<SettingsForm>();
+	let groups = $state<SettingsGroups>();
+	onMount(() => {
+		const specs = settings.registry.fieldsFor(screen);
+		let created: SettingsForm | undefined;
+		let off: (() => void) | void;
+		let gone = false;
+		// The sections' text is in before the form mounts, so no label ever flashes as a field name.
+		void loadSettingMessages(specs.map((s) => s.section)).then(() => {
+			if (gone) return;
+			created = createSettingsForm({ id: screen.id, fields: specs, mode });
+			form = created;
+			off = oncreate?.(created);
+		});
+		return () => {
+			gone = true;
+			off?.();
+			created?.destroy();
+		};
+	});
+
+	// Show changed only lives in the URL (`?changed=1`), so the Overview can link to it.
+	// `replaceState` moves the address bar but not `page.url`, so the state is kept here and
+	// follows `page.url` whenever a real navigation changes it.
+	let changedOnly = $derived(page.url.searchParams.get('changed') === '1');
+	function setChanged(on: boolean) {
+		changedOnly = on;
+		const url = new URL(page.url);
+		if (on) url.searchParams.set('changed', '1');
+		else url.searchParams.delete('changed');
+		// eslint-disable-next-line svelte/no-navigation-without-resolve -- same page, no base path
+		replaceState(url, page.state);
+	}
+
+	const reveal = (key: FieldKey) => groups?.reveal(key);
+	const nothingChanged = $derived(
+		changedOnly && form !== undefined && form.specs.every((s) => !form!.field(s.key).changed)
+	);
+</script>
+
+<div class="flex flex-col gap-6" data-testid="settings-screen-{screen.id}">
+	<header class="flex flex-col gap-2">
+		<h1 tabindex="-1" class="text-display font-semibold outline-none">{screen.title()}</h1>
+		{#if purpose}<p class="text-body text-muted-text">{purpose}</p>{/if}
+	</header>
+	{#if form}
+		<Toggle
+			label={m.settings_ui_changed_only()}
+			checked={changedOnly}
+			onchange={(e) => setChanged(e.currentTarget.checked)}
+			data-testid="settings-changed-only"
+		/>
+		<SettingsFormView {form} onReveal={reveal} leaveGuard={form.mode === 'staged'}>
+			{#if nothingChanged}
+				<p data-testid="settings-nothing-changed">{m.settings_ui_nothing_changed()}</p>
+			{/if}
+			<SettingsGroups
+				bind:this={groups}
+				{form}
+				screen={screen.id}
+				{changedOnly}
+				after={afterGroup}
+			/>
+			{#if Config}<Config {form} specs={form.specs} />{/if}
+			{@render footer?.()}
+		</SettingsFormView>
+	{:else}
+		<p class="text-muted-text" aria-busy="true">{m.settings_ui_loading()}</p>
+	{/if}
+</div>
diff --git a/web/src/lib/features/settings/screens/NetworkScreen.svelte b/web/src/lib/features/settings/screens/NetworkScreen.svelte
new file mode 100644
index 00000000..0e8ffe76
--- /dev/null
+++ b/web/src/lib/features/settings/screens/NetworkScreen.svelte
@@ -0,0 +1,30 @@
+<script lang="ts">
+	// Network & VPN (§10.10.8): the generated fields, the lockout dialog as this screen's own
+	// disruptive gate, and the reachability panel beside the DHT group. Egress, the kill switch and
+	// the VPN parts have no schema fields yet, so nothing shows for them.
+	import { onDestroy, type Component } from 'svelte';
+	import type { SettingsForm } from '../form';
+	import type { ResolvedScreen } from '../shell/registry';
+	import GeneratedScreen from './GeneratedScreen.svelte';
+
+	let { resolved }: { resolved: ResolvedScreen } = $props();
+
+	// The panel and its refresh load when the screen opens, not with the route.
+	let Panel = $state.raw<Component>();
+	void import('./ReachabilityPanel.svelte').then((mod) => (Panel = mod.default));
+
+	const asking = new AbortController();
+	onDestroy(() => asking.abort());
+	// The dialog's text and code load when a disruptive change is saved, not with the screen.
+	const oncreate = (form: SettingsForm) =>
+		form.gate('disruptive', async (c) => {
+			const { lockoutGate } = await import('./lockout');
+			return lockoutGate(asking.signal)(c);
+		});
+</script>
+
+<GeneratedScreen {resolved} {oncreate}>
+	{#snippet afterGroup(group)}
+		{#if group === 'dht' && Panel}<Panel />{/if}
+	{/snippet}
+</GeneratedScreen>
diff --git a/web/src/lib/features/settings/screens/ReachabilityPanel.svelte b/web/src/lib/features/settings/screens/ReachabilityPanel.svelte
new file mode 100644
index 00000000..bf062908
--- /dev/null
+++ b/web/src/lib/features/settings/screens/ReachabilityPanel.svelte
@@ -0,0 +1,183 @@
+<script module lang="ts">
+	/** How often the answer is asked for again while the screen is open and visible. */
+	export const REFRESH_MS = 30_000;
+</script>
+
+<script lang="ts">
+	// "Reachable from the internet" (§10.10.8, B14): the network check as plain words, the address
+	// other nodes see, the evidence behind the answer and Check again. It refreshes every 30 s while
+	// the screen is open and visible. Every number is the server's; an unknown one is "—".
+	import { onMount } from 'svelte';
+	import { ApiError, api, isAbort } from '$lib/api/client';
+	import { formatCount, formatSpan, DASH } from '$lib/format';
+	import { currentLocale } from '$lib/i18n/locale.svelte';
+	import { m } from '$lib/paraglide/messages.js';
+	import Button from '$lib/ui/controls/Button.svelte';
+	import Mono from '$lib/ui/labels/Mono.svelte';
+	import IconOk from '~icons/ph/check-circle';
+	import IconBad from '~icons/ph/warning';
+	import IconWait from '~icons/ph/spinner-gap';
+	import type { components } from '$lib/api/schema';
+
+	type Check = components['schemas']['NetworkCheck'];
+
+	let check = $state.raw<Check>();
+	let failed = $state(false);
+	let checking = $state(false);
+	let wait = $state<{ seconds?: number }>();
+
+	const locale = $derived(currentLocale());
+	const outcome = $derived(
+		check?.reachable === true ? 'yes' : check?.reachable === false ? 'no' : 'maybe'
+	);
+
+	async function refresh(signal?: AbortSignal) {
+		try {
+			check = await api.get('/network/check', { signal });
+			failed = false;
+		} catch (e) {
+			if (!isAbort(e)) failed = true;
+		}
+	}
+
+	async function again() {
+		checking = true;
+		wait = undefined;
+		try {
+			check = await api.post('/network/check');
+			failed = false;
+		} catch (e) {
+			if (e instanceof ApiError && e.code === 'rate_limited') wait = { seconds: e.retryAfter };
+			else failed = true;
+		} finally {
+			checking = false;
+		}
+	}
+
+	onMount(() => {
+		const ctl = new AbortController();
+		void refresh(ctl.signal);
+		const timer = setInterval(() => {
+			if (document.visibilityState === 'visible') void refresh(ctl.signal);
+		}, REFRESH_MS);
+		const onVisible = () => {
+			if (document.visibilityState === 'visible') void refresh(ctl.signal);
+		};
+		document.addEventListener('visibilitychange', onVisible);
+		return () => {
+			ctl.abort();
+			clearInterval(timer);
+			document.removeEventListener('visibilitychange', onVisible);
+		};
+	});
+
+	function reason(c: Check): string {
+		switch (c.reason) {
+			case 'dht_off':
+				return m.settings_ui_reach_dht_off();
+			case 'bootstrapping':
+				return m.settings_ui_reach_bootstrapping();
+			case 'measuring':
+				return m.settings_ui_reach_measuring({
+					time: formatSpan(Math.max(0, c.min_window_s - c.measured_s), locale)
+				});
+			case 'unsolicited_queries':
+				return m.settings_ui_reach_unsolicited_queries();
+			case 'few_unsolicited_sources':
+				return m.settings_ui_reach_few_sources();
+			case 'no_unsolicited_queries':
+				return m.settings_ui_reach_none();
+			default:
+				return '';
+		}
+	}
+
+	/** `ip:port`, with an IPv6 address in brackets; null while there is no consensus. */
+	function address(c: Check): string | null {
+		const { ip, port } = c.external;
+		if (ip === null || port === null) return null;
+		return ip.includes(':') ? `[${ip}]:${port}` : `${ip}:${port}`;
+	}
+</script>
+
+<section
+	class="flex flex-col gap-3 rounded-box border border-base-300 p-4"
+	aria-labelledby="reach-title"
+	data-testid="settings-reach"
+>
+	<h3 id="reach-title" class="text-body-lg font-semibold">{m.settings_ui_reach_title()}</h3>
+	{#if check}
+		<p
+			class="flex items-center gap-2 font-medium"
+			data-testid="settings-reach-status"
+			data-state={outcome}
+		>
+			{#if outcome === 'yes'}
+				<IconOk class="size-(--icon-size-row) shrink-0 text-success" aria-hidden="true" />
+				{m.settings_ui_reach_yes()}
+			{:else if outcome === 'no'}
+				<IconBad class="size-(--icon-size-row) shrink-0 text-error" aria-hidden="true" />
+				{m.settings_ui_reach_no()}
+			{:else}
+				<IconWait class="size-(--icon-size-row) shrink-0" aria-hidden="true" />
+				{m.settings_ui_reach_checking()}
+			{/if}
+		</p>
+		<p data-testid="settings-reach-reason">{reason(check)}</p>
+		<dl class="reach-facts text-small">
+			<dt>{m.settings_ui_reach_address()}</dt>
+			<dd data-testid="settings-reach-address">
+				{#if address(check)}<Mono>{address(check)}</Mono>{:else}<span
+						aria-label={m.settings_ui_reach_unknown()}>{DASH}</span
+					>{/if}
+			</dd>
+			<dt>{m.settings_ui_reach_inbound()}</dt>
+			<dd data-testid="settings-reach-inbound">
+				{#if check.inbound_queries === null}<span aria-label={m.settings_ui_reach_unknown()}
+						>{DASH}</span
+					>{:else}{formatCount(check.inbound_queries, locale)}{/if}
+			</dd>
+			<dt>{m.settings_ui_reach_unsolicited()}</dt>
+			<dd data-testid="settings-reach-unsolicited">
+				{#if check.unsolicited_queries === null}<span aria-label={m.settings_ui_reach_unknown()}
+						>{DASH}</span
+					>{:else}{formatCount(check.unsolicited_queries, locale)}{/if}
+			</dd>
+			<dt>{m.settings_ui_reach_sources()}</dt>
+			<dd data-testid="settings-reach-sources">
+				{#if check.unsolicited_sources === null}<span aria-label={m.settings_ui_reach_unknown()}
+						>{DASH}</span
+					>{:else}{formatCount(check.unsolicited_sources, locale)}{/if}
+			</dd>
+		</dl>
+	{:else if failed}
+		<p role="alert" data-testid="settings-reach-failed">{m.settings_ui_reach_failed()}</p>
+	{:else}
+		<p aria-busy="true" class="flex items-center gap-2">
+			<IconWait
+				class="size-(--icon-size-row) shrink-0"
+				aria-hidden="true"
+			/>{m.settings_ui_reach_checking()}
+		</p>
+	{/if}
+	<div class="flex flex-wrap items-center gap-3">
+		<Button loading={checking} onclick={() => void again()} data-testid="settings-reach-again"
+			>{m.settings_ui_reach_again()}</Button
+		>
+		{#if wait}
+			<p role="status" class="text-small" data-testid="settings-reach-wait">
+				{wait.seconds === undefined
+					? m.settings_ui_reach_wait()
+					: m.settings_ui_reach_wait_for({ time: formatSpan(wait.seconds, locale) })}
+			</p>
+		{/if}
+	</div>
+</section>
+
+<style>
+	.reach-facts {
+		display: grid;
+		grid-template-columns: auto 1fr;
+		gap: calc(var(--spacing) * 1) calc(var(--spacing) * 4);
+	}
+</style>
diff --git a/web/src/lib/features/settings/screens/SettingsGroups.svelte b/web/src/lib/features/settings/screens/SettingsGroups.svelte
new file mode 100644
index 00000000..73472f0a
--- /dev/null
+++ b/web/src/lib/features/settings/screens/SettingsGroups.svelte
@@ -0,0 +1,168 @@
+<script lang="ts">
+	// A form's fields as groups (§10.10.2): each with a heading, its essentials as `SettingField`s,
+	// then "Advanced (n)", a closed disclosure remembered per screen. Generated screens render
+	// this; hand-built screens embed it where they can (§10.10.8), inside their own
+	// `<SettingsForm {form}>`, so the field behaves the same everywhere. A screen never builds a
+	// field by hand. It also answers deep links (`#crawler.intensity`) once the form is ready.
+	//
+	// `onReveal` for `<SettingsForm>` (the error summary's links): `onReveal={(k) => groups?.reveal(k)}`
+	// with `bind:this={groups}`.
+	import { page } from '$app/state';
+	import { formatCount } from '$lib/format';
+	import { currentLocale } from '$lib/i18n/locale.svelte';
+	import { m } from '$lib/paraglide/messages.js';
+	import { tick, untrack, type Snippet } from 'svelte';
+	import { SvelteSet } from 'svelte/reactivity';
+	import {
+		groupFields,
+		settingText,
+		type FieldKey,
+		type FieldSpec,
+		type SettingsForm
+	} from '../form';
+	import SettingField from '../form/SettingField.svelte';
+	import { readOpen, writeOpen } from './advanced';
+	import { fieldFromHash, showField } from './deeplink';
+
+	interface Props {
+		form: SettingsForm;
+		/** The fields to show; the form's own by default. */
+		specs?: FieldSpec[];
+		/** The screen's id: where the Advanced disclosures are remembered. */
+		screen: string;
+		/** Only fields that differ from their default (Show changed only). */
+		changedOnly?: boolean;
+		/** Appended to a group (the Network screen's reachability panel). */
+		after?: Snippet<[group: string]>;
+	}
+
+	let { form, specs, screen, changedOnly = false, after }: Props = $props();
+
+	const shown = $derived(specs ?? form.specs);
+	const groups = $derived(
+		groupFields(shown)
+			.map((g) => {
+				if (!changedOnly) return g;
+				const changed = (s: FieldSpec) => form.field(s.key).changed;
+				return {
+					...g,
+					essentials: g.essentials.filter(changed),
+					advanced: g.advanced.filter(changed)
+				};
+			})
+			.filter((g) => g.essentials.length + g.advanced.length > 0)
+	);
+
+	// What the user opened (kept in storage) and what a reveal opened (a deep link, search, the
+	// error summary, Show changed only: not remembered).
+	// The screen id never changes while mounted.
+	const remembered = new SvelteSet<string>(readOpen(untrack(() => screen)));
+	const revealed = new SvelteSet<string>();
+	const isOpen = (group: string) => changedOnly || remembered.has(group) || revealed.has(group);
+
+	function toggled(group: string, open: boolean) {
+		if (open) {
+			if (revealed.has(group) || changedOnly) return;
+			remembered.add(group);
+		} else {
+			remembered.delete(group);
+			revealed.delete(group);
+		}
+		writeOpen(screen, remembered);
+	}
+
+	/** Opens the Advanced disclosure holding a field, without remembering it. Resolves once it's in the DOM. */
+	export async function reveal(key: FieldKey): Promise<void> {
+		const group = groupFields(shown).find((g) => g.advanced.some((s) => s.key === key));
+		if (group && !isOpen(group.group)) {
+			revealed.add(group.group);
+			await tick();
+		}
+	}
+
+	const keys = $derived(shown.map((s) => s.key));
+	const hash = $derived(page.url.hash);
+	$effect(() => {
+		const key = fieldFromHash(hash, keys);
+		if (!key || form.status === 'loading' || form.status === 'load-error') return;
+		void reveal(key).then(() => showField(key));
+	});
+</script>
+
+{#each groups as g (g.group)}
+	<section class="flex flex-col gap-4" aria-labelledby="group-{screen}-{g.group}">
+		<h2 id="group-{screen}-{g.group}" class="text-title font-semibold">
+			{settingText(g.labelKey) ?? g.group}
+		</h2>
+		{#each g.essentials as s (s.key)}
+			<SettingField {form} key={s.key} />
+		{/each}
+		{#if g.advanced.length}
+			<details
+				class="settings-advanced"
+				open={isOpen(g.group)}
+				ontoggle={(e) => toggled(g.group, e.currentTarget.open)}
+				data-testid="advanced-{g.group}"
+			>
+				<summary class="settings-advanced-summary"
+					>{m.settings_ui_advanced({
+						count: formatCount(g.advanced.length, currentLocale())
+					})}</summary
+				>
+				<div class="settings-advanced-body">
+					{#each g.advanced as s (s.key)}
+						<SettingField {form} key={s.key} />
+					{/each}
+				</div>
+			</details>
+		{/if}
+		{@render after?.(g.group)}
+	</section>
+{/each}
+
+<style>
+	.settings-advanced-summary {
+		display: flex;
+		align-items: center;
+		min-height: var(--control-height);
+		cursor: pointer;
+	}
+	@media (pointer: coarse) {
+		.settings-advanced-summary {
+			min-height: var(--target-min);
+		}
+	}
+	.settings-advanced-summary:focus-visible {
+		outline-style: solid;
+		outline-width: var(--focus-ring-width);
+		outline-color: var(--color-primary);
+		outline-offset: var(--focus-ring-offset);
+	}
+	.settings-advanced-body {
+		display: flex;
+		flex-direction: column;
+		gap: calc(var(--spacing) * 4);
+		margin-top: calc(var(--spacing) * 2);
+	}
+	/* A deep link's target: fades in, then out; under reduced motion it holds a static ring. */
+	:global([data-field][data-highlight]) {
+		outline-style: solid;
+		outline-width: var(--focus-ring-width);
+		outline-color: var(--color-primary);
+		outline-offset: var(--focus-ring-offset);
+		animation: settings-highlight 2s var(--ease-out);
+	}
+	@keyframes settings-highlight {
+		from {
+			outline-color: transparent;
+		}
+		20% {
+			outline-color: var(--color-primary);
+		}
+	}
+	@media (prefers-reduced-motion: reduce) {
+		:global([data-field][data-highlight]) {
+			animation: none;
+		}
+	}
+</style>
diff --git a/web/src/lib/features/settings/screens/advanced.ts b/web/src/lib/features/settings/screens/advanced.ts
new file mode 100644
index 00000000..ff2c147f
--- /dev/null
+++ b/web/src/lib/features/settings/screens/advanced.ts
@@ -0,0 +1,24 @@
+// Which Advanced disclosures a screen leaves open (§10.10.2): remembered per screen in
+// `localStorage` under `lodestar.settings.advanced.<screen>` as the list of open group ids. Every
+// access is in a try/catch: storage may be blocked, full or absent, and nothing else depends on it.
+const KEY = 'lodestar.settings.advanced.';
+
+export function readOpen(screen: string): string[] {
+	try {
+		const raw = localStorage.getItem(KEY + screen);
+		const value: unknown = raw === null ? [] : JSON.parse(raw);
+		return Array.isArray(value) ? value.filter((v): v is string => typeof v === 'string') : [];
+	} catch {
+		return [];
+	}
+}
+
+export function writeOpen(screen: string, groups: Iterable<string>): void {
+	try {
+		const list = [...groups];
+		if (list.length) localStorage.setItem(KEY + screen, JSON.stringify(list));
+		else localStorage.removeItem(KEY + screen);
+	} catch {
+		// Blocked or full: the disclosure just isn't remembered.
+	}
+}
diff --git a/web/src/lib/features/settings/screens/backup.test.ts b/web/src/lib/features/settings/screens/backup.test.ts
