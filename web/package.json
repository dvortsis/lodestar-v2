{
	"name": "lodestar-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"assets": "node --experimental-strip-types scripts/assets.ts",
		"fonts": "node scripts/fonts.mjs",
		"themes": "node --experimental-strip-types scripts/themes.ts",
		"prebuild": "npm run themes && npm run assets && npm run messages",
		"build": "vite build",
		"preview": "vite preview",
		"check": "npm run messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint . && prettier --check . && node scripts/check-bans.mjs",
		"format": "prettier --write .",
		"test": "vitest",
		"e2e": "playwright test",
		"e2e:core": "playwright test --project=core",
		"e2e:matrix": "playwright test --project='bp*'",
		"e2e:sample": "playwright test --project='sample-*'",
		"e2e:motion": "playwright test --project=reduced-motion",
		"e2e:keyboard": "playwright test --project=keyboard-only",
		"e2e:all-themes": "E2E_ALL_THEMES=1 playwright test --project=all-themes",
		"e2e:typecheck": "tsc -p e2e",
		"e2e:update": "playwright test --update-snapshots",
		"size": "size-limit",
		"api:types": "node scripts/api-types.mjs",
		"messages": "node --experimental-strip-types scripts/messages.ts && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"lhci": "lhci autorun --config=lighthouserc.json && lhci autorun --config=lighthouserc.desktop.json"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@tanstack/svelte-virtual": "3.13.47",
		"bits-ui": "2.20.0",
		"uplot": "1.6.32"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "9.39.5",
		"@iconify-json/ph": "1.2.2",
		"@inlang/paraglide-js": "2.29.1",
		"@inlang/plugin-message-format": "4.5.5",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.56.1",
		"@size-limit/preset-app": "14.2.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"daisyui": "5.7.50",
		"eslint": "9.39.5",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"sharp": "0.35.5",
		"size-limit": "14.2.0",
		"subset-font": "2.9.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"unplugin-icons": "24.0.0",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
