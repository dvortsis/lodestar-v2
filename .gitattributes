# Frontend tools and committed generated assets use LF on every host.
/web/** text=auto eol=lf
# These textual originals are verified byte-for-byte against SHA256SUMS.txt.
/brand/source/** text=auto eol=lf
# Parser goldens and fuzz seeds are raw bytes: never convert line endings.
crates/metainfo/tests/golden/** -text
fuzz/seeds/** -text
docs/operations/imports/bitmagnet-restore/** text eol=lf
/infra/**/*.sh text eol=lf
# PIA delivery verifies the exact bytes of its committed certificate.
/infra/pia-bridge/vm/pia-ca.rsa.4096.crt text eol=lf
# Windows batch files run with CRLF line endings: cmd can miss labels and
# misparse lines in a file with Unix ones (#651).
/packaging/windows/**/*.cmd text eol=crlf
# gluetun's post-rules are pinned by SHA-256 in the guide and embedded with
# include_str!, so every checkout holds the same LF bytes.
/crates/companions/src/gluetun-post-rules.txt text eol=lf
/packaging/companions/gluetun-post-rules.txt text eol=lf
