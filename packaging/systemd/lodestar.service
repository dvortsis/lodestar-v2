[Unit]
Description=Lodestar DHT crawler and torrent search
Documentation=https://github.com/dvortsis/lodestar-v2/blob/main/docs/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lodestar serve
Restart=on-failure
RestartSec=5

# State lives in /var/lib/lodestar (created and owned by systemd). The
# restart proof's witness (dht.safe_restart) lives beside it, not in it,
# so a backup of the data directory never holds it: don't back the two up
# together.
DynamicUser=yes
StateDirectory=lodestar lodestar-witness
StateDirectoryMode=0700
Environment=LODESTAR_DATA_DIR=/var/lib/lodestar
Environment=LODESTAR_DHT_WITNESS_DIR=/var/lib/lodestar-witness

# Below-normal priority so the crawler yields to other work on the host.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# 400 metadata sockets at the Balanced intensity (1000 at Aggressive),
# plus the DHT socket, SQLite, index segments and the HTTP listener.
LimitNOFILE=8192

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
