<?xml version="1.0"?>
<Container version="2">
  <Name>qbittorrent</Name>
  <Repository>lscr.io/linuxserver/qbittorrent@sha256:abababababababababababababababababababababababababababababababab</Repository>
  <Network>lodestar</Network>
  <MyIP/>
  <Privileged>false</Privileged>
  <Support>https://www.qbittorrent.org/</Support>
  <Project>https://www.qbittorrent.org/</Project>
  <Overview>qBittorrent, the download client Lodestar sends your downloads to. Generated by Lodestar: it configures qBittorrent once it&apos;s running. Mount real folders only, never a link to somewhere else. Applying it replaces a container or template you already have with the same name: check first. Create the Docker network first: Unraid starts a container on a network it doesn&apos;t know with none.</Overview>
  <Category>Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/qbittorrent" Mode="rw" Description="Its settings. A real folder of its own, not a link." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/qbittorrent</Config>
  <Config Name="Downloads" Target="/downloads" Default="/mnt/user/downloads" Mode="rw" Description="Where downloads are saved. A real folder, not a link." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/downloads</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="rw" Description="Set by Lodestar." Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="rw" Description="Set by Lodestar." Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="TZ" Target="TZ" Default="Etc/UTC" Mode="rw" Description="Set by Lodestar." Type="Variable" Display="advanced" Required="true" Mask="false">Etc/UTC</Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="rw" Description="Set by Lodestar." Type="Variable" Display="advanced" Required="true" Mask="false">022</Config>
  <Config Name="WEBUI_PORT" Target="WEBUI_PORT" Default="8080" Mode="rw" Description="Set by Lodestar." Type="Variable" Display="advanced" Required="true" Mask="false">8080</Config>
  <Config Name="TORRENTING_PORT" Target="TORRENTING_PORT" Default="6882" Mode="rw" Description="Set by Lodestar." Type="Variable" Display="advanced" Required="true" Mask="false">6882</Config>
  <Config Name="Web UI port" Target="8080" Default="8080" Mode="tcp" Description="Published on your network." Type="Port" Display="always" Required="false" Mask="false">8080</Config>
  <Config Name="Peer port (TCP)" Target="6882" Default="6882" Mode="tcp" Description="Published on your network." Type="Port" Display="always" Required="false" Mask="false">6882</Config>
  <Config Name="Peer port (UDP)" Target="6882" Default="6882" Mode="udp" Description="Published on your network." Type="Port" Display="always" Required="false" Mask="false">6882</Config>
</Container>
